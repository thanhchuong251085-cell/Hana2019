    private fun getOrCreateRoomId(): String {
        var roomId = getSharedPreferences("KaraokePrefs", Context.MODE_PRIVATE).getString("roomCode", null)
        if (roomId.isNullOrEmpty()) {
            roomId = Random.nextInt(10000, 99999).toString()
            getSharedPreferences("KaraokePrefs", Context.MODE_PRIVATE).edit().putString("roomCode", roomId).apply()
        }
        return roomId
    }

    private fun resetRoomCode() {
        if (isExitingApp) return
        try {
            database.getReference("rooms/$currentRoomId/localSongs").removeValue()
            database.getReference("rooms/$currentRoomId/iptv_channels").removeValue()
        } catch (_: Exception) {}
        getSharedPreferences("KaraokePrefs", Context.MODE_PRIVATE).edit().remove("roomCode").apply()

        currentRoomId = getOrCreateRoomId()
        recreate()
    }

    private fun listenToData() {
        if (isExitingApp) return
        try {
            roomRef = database.getReference("rooms/$currentRoomId")
            roomRef?.child("localSongs")?.onDisconnect()?.removeValue()

            roomValueEventListener = object : ValueEventListener {
                override fun onDataChange(snapshot: DataSnapshot) {
                    if (isExitingApp || isFinishing || isDestroyed) return
                    val tempList = ArrayList<SongData>()
                    snapshot.children.forEach { child ->
                        val map = child.value as? SongData
                        if (map != null) {
                            val mutableMap = map.toMutableMap()
                            mutableMap["key"] = child.key ?: ""

                            val type = (mutableMap["type"] ?: "").toString()
                            val localKey = (mutableMap["localKey"] ?: "").toString()
                            if ((type == "local" || localKey.isNotEmpty()) && !mutableMap.containsKey("url")) {
                                if (localSongsMap.containsKey(localKey)) {
                                    mutableMap["url"] = localSongsMap[localKey]!!
                                }
                            }
                            if (localKey.isNotEmpty() && localIsVideoMap.containsKey(localKey) && !mutableMap.containsKey("isVideo")) {
                                mutableMap["isVideo"] = localIsVideoMap[localKey] == true
                            }

                            tempList.add(mutableMap)
                        }
                    }

                    sortQueueItems(tempList)
                    playlist.clear()
                    playlist.addAll(tempList)
                    updateUI()
                }
                override fun onCancelled(error: DatabaseError) {}
            }
            roomRef?.child("playlist")?.addValueEventListener(roomValueEventListener as ValueEventListener)

            commandEventListener = object : ValueEventListener {
                override fun onDataChange(snapshot: DataSnapshot) {
                    if (isExitingApp || isFinishing || isDestroyed) return
                    val cmdData = snapshot.value
                    if (cmdData != null) {
                        executeCommand(cmdData)
                        roomRef?.child("command")?.removeValue()
                    }
                }
                override fun onCancelled(error: DatabaseError) {}
            }
            roomRef?.child("command")?.addValueEventListener(commandEventListener as ValueEventListener)
        } catch (e: Exception) {
            Log.e("KARA_FB", "Lỗi listenToData: ${e.message}")
        }
    }

    private fun listenToLocalSongs() {
        if (isExitingApp) return
        try {
            localSongsEventListener = object : ValueEventListener {
                override fun onDataChange(snapshot: DataSnapshot) {
                    if (isExitingApp || isFinishing || isDestroyed) return
                    val incomingList = ArrayList<SongData>()
                    val nextSongsMap = HashMap<String, String>()
                    val nextIsVideoMap = HashMap<String, Boolean>()

                    val songsData = snapshot.value as? Map<*, *>
                    songsData?.forEach { (k, v) ->
                        val map = v as? SongData
                        if (map != null) {
                            incomingList.add(map)
                            val lKey = (map["localKey"] ?: k).toString()
                            val urlVal = (map["url"] ?: "").toString()
                            val titleVal = (map["title"] ?: map["name"] ?: "").toString()
                            if (urlVal.isNotEmpty()) {
                                nextSongsMap[lKey] = urlVal
                                nextIsVideoMap[lKey] = isVideoMedia(map, urlVal, titleVal, lKey)
                            }
                        }
                    }

                    offlinePlaylist.clear()
                    offlinePlaylist.addAll(deduplicateSongMapList(incomingList))
                    localSongsMap.clear()
                    localSongsMap.putAll(nextSongsMap)
                    localIsVideoMap.clear()
                    localIsVideoMap.putAll(nextIsVideoMap)

                    refreshOfflineTabCallback?.invoke()
                }
                override fun onCancelled(error: DatabaseError) {}
            }
            roomRef?.child("localSongs")?.addValueEventListener(localSongsEventListener as ValueEventListener)
        } catch (e: Exception) {
            Log.e("KARA_FB", "Lỗi listenToLocalSongs: ${e.message}")
        }
    }

    private fun launchSongItem(song: SongData, consumeFromPlaylistIfPresent: Boolean) {
        if (isExitingApp || isFinishing || isDestroyed) return

        val songTitle = (song["title"] ?: song["name"] ?: "Không rõ").toString()
        val songType = (song["type"] ?: "").toString()
        val videoId = (song["videoId"] ?: "").toString()
        val directUrl = (song["url"] ?: song["videoUrl"] ?: "").toString()
        val localKey = (song["localKey"] ?: "").toString()
        val thumbUrl = (song["thumbnail"] ?: song["artwork"] ?: song["thumb"] ?: "").toString()
        val resolvedUrl = if (directUrl.isNotEmpty()) directUrl else (localSongsMap[localKey] ?: "")

        if (consumeFromPlaylistIfPresent) {
            val songKey = song["key"]?.toString()
            if (!songKey.isNullOrEmpty()) {
                playlist.removeAll { it["key"]?.toString() == songKey }
                try {
                    roomRef?.child("playlist")?.child(songKey)?.removeValue()
                } catch (_: Exception) {}
            }
        }

        hasActiveSongPlaying = true
        isPlaying = true
        activeDisplayTitle = if (songType == "soundcloud") "☁️ $songTitle" else "🎵 $songTitle"
        tvStatus.text = activeDisplayTitle
        tvStatus.isSelected = true

        if (songType == "soundcloud" && resolvedUrl.isNotEmpty()) {
            lastDispatchedVideoId = null
            lastDispatchedSoundCloudUrl = "NOW|$resolvedUrl|${System.currentTimeMillis()}"
            playSoundCloud(resolvedUrl, songTitle, thumbUrl)
        } else if (resolvedUrl.isNotEmpty()) {
            lastDispatchedVideoId = null
            lastDispatchedSoundCloudUrl = null
            val isVid = isVideoMedia(song, resolvedUrl, songTitle, localKey)
            playMediaExo(
                url = resolvedUrl,
                title = songTitle,
                thumbnailUrl = if (isVid) "" else thumbUrl,
                isVideoStream = isVid
            )
        } else if (videoId.isNotEmpty()) {
            lastDispatchedSoundCloudUrl = null
            lastDispatchedVideoId = "NOW|$videoId|${System.currentTimeMillis()}"
            playYouTube1080(videoId)
        }
    }

    private fun updateUI() {
        if (isExitingApp || isFinishing || isDestroyed) return

        if (!hasActiveSongPlaying) {
            if (playlist.isNotEmpty()) {
                launchSongItem(playlist[0], consumeFromPlaylistIfPresent = true)
            } else {
                lastDispatchedSoundCloudUrl = null
                activeDisplayTitle = "🕒 Chờ bài hát..."
                if (isOfflineActive || lastDispatchedVideoId != Play1080.IDLE_CAR_VIDEO_ID) {
                    lastDispatchedVideoId = Play1080.IDLE_CAR_VIDEO_ID
                    stopPlayer()
                } else {
                    isPlaying = false
                    syncPlayerKeepScreenOn()
                }
            }
        }

        tvStatus.text = activeDisplayTitle
        tvStatus.isSelected = true

        layoutPlaylist.removeAllViews()
        for (i in 0 until minOf(playlist.size, 11)) {
            val song = playlist[i]
            val li = TextView(this).apply {
                text = "${i + 1}. ${song["title"] ?: song["name"] ?: ""}"
                setTextColor(Color.parseColor("#F2FFFFFF"))
                textSize = 13f
                maxLines = 1
                ellipsize = TextUtils.TruncateAt.END
                setPadding(0, 2.dp(), 0, 2.dp())
            }
            layoutPlaylist.addView(li)
        }
    }

    private fun playOfflineSongImmediately(song: SongData) {
        if (isExitingApp || isFinishing || isDestroyed) return
        val directTitle = (song["title"] ?: song["name"] ?: "Bài hát offline").toString()
        val directUrl = (song["url"] ?: "").toString()
        val localKey = (song["localKey"] ?: "").toString()
        val thumbUrl = (song["thumbnail"] ?: song["artwork"] ?: song["thumb"] ?: "").toString()

        val finalUrl = if (directUrl.isNotEmpty()) directUrl else (localSongsMap[localKey] ?: "")
        val isVid = isVideoMedia(song, finalUrl, directTitle, localKey)

        hasActiveSongPlaying = true
        isPlaying = true
        activeDisplayTitle = "🎵 $directTitle"
        tvStatus.text = activeDisplayTitle
        tvStatus.isSelected = true

        if (finalUrl.isNotEmpty()) {
            lastDispatchedVideoId = null
            lastDispatchedSoundCloudUrl = null
            playMediaExo(
                url = finalUrl,
                title = directTitle,
                thumbnailUrl = if (isVid) "" else thumbUrl,
                isVideoStream = isVid
            )
        }

        val nowMs = System.currentTimeMillis()
        val songKey = "song_$nowMs"
        val songDataWithTime = mapOf(
            "type" to "local",
            "localKey" to localKey,
            "title" to directTitle,
            "name" to directTitle,
            "url" to finalUrl,
            "isVideo" to isVid,
            "mediaType" to if (isVid) "video" else "audio",
            "priority" to false,
            "prioritySeq" to 0L,
            "clientTimestamp" to nowMs,
            "timestamp" to nowMs
        )
        try {
            roomRef?.child("playlist")?.child(songKey)?.setValue(songDataWithTime)
        } catch (_: Exception) {}
    }

    private fun playMediaExo(
        url: String,
        title: String = "",
        thumbnailUrl: String = "",
        isVideoStream: Boolean = false
    ) {
        if (isExitingApp || isFinishing || isDestroyed) return
        try {
            runOnUiThread {
                if (isExitingApp || isFinishing || isDestroyed) return@runOnUiThread
                pauseAndSilencePlay1080()

                if (isVideoStream) {
                    hideArtworkView()
                } else {
                    loadAudioCoverArt(thumbnailUrl, title, isVideoStream = false)
                }

                if (isOfflineActive && currentOfflineUrl == url) {
                    if (isVideoStream) {
                        hideArtworkView()
                        playerView?.visibility = View.VISIBLE
                        playerView?.bringToFront()
                    }
                    exoHostContainer?.visibility = View.VISIBLE
                    playerView?.useController = false
                    isPlaying = true
                    exoPlayer?.volume = CLEAN_LINEAR_AUDIO_VOLUME
                    exoPlayer?.playWhenReady = true
                    exoPlayer?.play()
                    updateOfflineKeepScreenOn(true)
                    showCustomControlBar()
                    return@runOnUiThread
                }

                exoPlayer?.stop()
                exoPlayer?.clearMediaItems()

                hasActiveSongPlaying = true
                isOfflineActive = true
                isPlaying = true
                currentOfflineUrl = url
                setWelcomeBlinking(false)

                exoHostContainer?.visibility = View.VISIBLE
                if (isVideoStream) {
                    hideArtworkView()
                    playerView?.visibility = View.VISIBLE
                    playerView?.bringToFront()
                } else {
                    playerView?.visibility = View.GONE
                }
                playerView?.useController = false
                updateOfflineKeepScreenOn(true)
                showCustomControlBar()

                exoPlayer?.let { player ->
                    player.volume = CLEAN_LINEAR_AUDIO_VOLUME
                    player.playWhenReady = true
                    player.setMediaItem(MediaItem.fromUri(Uri.parse(url)))
                    player.prepare()
                }
            }
        } catch (e: Exception) {
            Log.e("KARA_MEDIA", "Lỗi phát ExoPlayer: ${e.message}")
            updateOfflineKeepScreenOn(false)
        }
    }

    private fun playYouTube1080(videoId: String) {
        if (isExitingApp || isFinishing || isDestroyed) return
        runOnUiThread {
            if (isExitingApp || isFinishing || isDestroyed) return@runOnUiThread
            val isIdleCar = videoId == Play1080.IDLE_CAR_VIDEO_ID
            hasActiveSongPlaying = !isIdleCar
            isOfflineActive = false
            clearOfflinePlayerState(hideView = true)
            setWelcomeBlinking(isIdleCar)
            isPlaying = !isIdleCar
            play1080?.keepScreenOn = !isIdleCar && isPlaying
            syncPlayerKeepScreenOn()
            play1080?.playVideoId(videoId)
        }
    }

    private fun advanceToNextFromQueue() {
        hasActiveSongPlaying = false
        if (playlist.isNotEmpty()) {
            launchSongItem(playlist[0], consumeFromPlaylistIfPresent = true)
            updateUI()
        } else {
            stopPlayer()
            updateUI()
        }
    }

    private fun removeCurrentSong() {
        advanceToNextFromQueue()
    }

    private fun removeCurrentSongSilently() {
        if (isExitingApp || isFinishing || isDestroyed) return
        advanceToNextFromQueue()
