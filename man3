    }

    private fun groupChannelsIntoHorizontalRows(channels: List<iptvmanager.KenhIptv>): List<Pair<String, List<iptvmanager.KenhIptv>>> {
        val groups = LinkedHashMap<String, MutableList<iptvmanager.KenhIptv>>()

        for (channel in channels) {
            val rawName = channel.tenKenh.trim().uppercase(Locale.US)
            val rawGroup = channel.nhom.trim()
            val rowKey = when {
                rawName.startsWith("VTV") && !rawName.startsWith("VTVCAB") -> "VTV"
                rawName.startsWith("VTVCAB") || rawName.startsWith("VTV CAB") -> "VTVcab"
                rawName.startsWith("SCTV") -> "SCTV"
                rawName.startsWith("HTV") -> "HTV"
                rawName.startsWith("THVL") -> "THVL"
                rawName.startsWith("HBO") -> "HBO"
                rawGroup.isNotBlank() && !rawGroup.equals("Truyền hình", ignoreCase = true) -> rawGroup
                else -> rawName.split(" ", "-", "_", ":").firstOrNull()?.takeIf { it.isNotBlank() } ?: "Khác"
            }
            groups.getOrPut(rowKey) { mutableListOf() }.add(channel)
        }

        return groups.map { it.key to it.value }
    }

