    private fun pickBestSoundCloudStream(audioStreams: List<AudioStream>): AudioStream? {
        val valid = audioStreams.filter { !it.content.isNullOrBlank() }
        if (valid.isEmpty()) return null
        return valid.maxWithOrNull(
            compareBy<AudioStream> { it.averageBitrate }
                .thenBy { stream ->
                    val fmt = (stream.format?.name ?: stream.getFormat()?.name ?: "").lowercase(Locale.US)
                    when {
                        fmt.contains("opus") -> 3
                        fmt.contains("m4a") || fmt.contains("aac") || fmt.contains("mp4") -> 2
                        fmt.contains("mp3") -> 1
                        else -> 0
                    }
                }
        )
    }

    private fun playSoundCloud(soundCloudPageUrl: String, title: String = "", thumbnailUrl: String = "") {
        if (isExitingApp || isFinishing || isDestroyed) return
        initNewPipeIfNeeded()

        runOnUiThread {
            if (isExitingApp || isFinishing || isDestroyed) return@runOnUiThread
            stopExoCompletely(hideHost = false, keepArtwork = true)
            pauseAndSilencePlay1080()
            hasActiveSongPlaying = true
            isOfflineActive = true
            isSoundCloudSession = true
            isPlaying = true
            setWelcomeBlinking(false)
            if (title.isNotEmpty()) {
                activeDisplayTitle = "☁️ $title"
                tvStatus.text = activeDisplayTitle
                tvStatus.isSelected = true
            }
            exoHostContainer?.visibility = View.VISIBLE
            exoHostContainer?.setBackgroundColor(Color.BLACK)
            loadAudioCoverArt(thumbnailUrl, title, isVideoStream = false)
            syncPlayerKeepScreenOn()
            showCustomControlBar()
        }
        showToast("☁️ Đang bóc tách SoundCloud...")

        if (mediaBackgroundExecutor.isShutdown) return
        mediaBackgroundExecutor.execute {
            if (isExitingApp || isFinishing || isDestroyed || mediaBackgroundExecutor.isShutdown) return@execute
            try {
                val extractor = ServiceList.SoundCloud.getStreamExtractor(soundCloudPageUrl)
                extractor.fetchPage()

                val resolvedThumb = if (thumbnailUrl.isNotBlank()) {
                    thumbnailUrl
                } else {
                    extractor.thumbnails.maxByOrNull { it.height * it.width }?.url.orEmpty()
                }

                val bestStream = pickBestSoundCloudStream(extractor.audioStreams)
                val streamUrl = bestStream?.content
                if (streamUrl.isNullOrBlank()) {
                    runOnUiThread {
                        if (!isExitingApp && !isFinishing && !isDestroyed) {
                            showToast("⚠️ Không lấy được luồng nhạc SoundCloud")
                        }
                    }
                    return@execute
                }

                runOnUiThread {
                    if (!isSoundCloudSession || isExitingApp || isFinishing || isDestroyed) return@runOnUiThread
                    lastDispatchedVideoId = null
                    playMediaExo(
                        url = streamUrl,
                        title = title,
                        thumbnailUrl = resolvedThumb,
                        isVideoStream = false
                    )
                }
            } catch (e: Exception) {
                Log.e("KARA_SC", "Lỗi bóc tách SoundCloud ($soundCloudPageUrl): ${e.message}")
                runOnUiThread {
                    if (!isExitingApp && !isFinishing && !isDestroyed) {
                        showToast("⚠️ Lỗi bóc tách SoundCloud: ${e.message ?: "Không xác định"}")
                    }
                }
            }
        }
    }

