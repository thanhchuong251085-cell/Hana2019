    private fun sendSelectedOfflineSongsToFirebase(selectedItems: List<ScannedLocalMedia>) {
        val uniqueItems = deduplicateScannedMedia(selectedItems)
        if (uniqueItems.isEmpty()) {
            showToast("⚠️ Bạn chưa chọn bài nào")
            return
        }

        val baseTime = System.currentTimeMillis()
        val localSongsUpdates = HashMap<String, Any>()
        val nextOfflineList = ArrayList<SongData>(uniqueItems.size)

        uniqueItems.forEachIndexed { idx, media ->
            val localKey = "song_${baseTime}_${idx}_${(1000..9999).random()}"
            val localEntry = mapOf<String, Any>(
                "localKey" to localKey,
                "title" to media.title,
                "name" to media.title,
                "url" to media.url,
                "isVideo" to media.isVideo,
                "mediaType" to if (media.isVideo) "video" else "audio"
            )
            localSongsMap[localKey] = media.url
            localIsVideoMap[localKey] = media.isVideo
            localSongsUpdates[localKey] = localEntry
            nextOfflineList.add(localEntry)
        }

        if (localSongsUpdates.isNotEmpty() && !isExitingApp) {
            try {
                roomRef?.child("localSongs")?.updateChildren(localSongsUpdates)
            } catch (e: Exception) {
                Log.e("KARA_OFFLINE", "Lỗi đồng bộ localSongs lên Firebase: ${e.message}")
            }
        }

        offlinePlaylist.clear()
        offlinePlaylist.addAll(deduplicateSongMapList(nextOfflineList))
        refreshOfflineTabCallback?.invoke()

        showToast("✅ Đã gửi ${uniqueItems.size} bài xuống danh sách offline cho remote!")
    }

    private fun exitApplicationCompletely() {
        if (isExitingApp) return
        isExitingApp = true
        isOfflineScanInProgress = false
        pendingAfterOfflineScanAction = null

        try {
            logoLoaderExecutor.shutdownNow()
        } catch (_: Exception) {}
        try {
            mediaBackgroundExecutor.shutdownNow()
        } catch (_: Exception) {}

        try {
            iptvLinkManagerDialog?.dismiss()
        } catch (_: Exception) {}
        iptvLinkManagerDialog = null

        try {
            offlineFolderDialog?.dismiss()
        } catch (_: Exception) {}
        offlineFolderDialog = null

        try {
            tvAndOfflineDialog?.dismiss()
        } catch (_: Exception) {}
        tvAndOfflineDialog = null

        stopProgressTicker()
        mainHandler.removeCallbacksAndMessages(null)
        blinkHandler.removeCallbacksAndMessages(null)
        shouldBlinkWelcome = false

        try {
            roomValueEventListener?.let { roomRef?.child("playlist")?.removeEventListener(it) }
            commandEventListener?.let { roomRef?.child("command")?.removeEventListener(it) }
            localSongsEventListener?.let { roomRef?.child("localSongs")?.removeEventListener(it) }
            iptvCommandEventListener?.let { roomRef?.child("iptv_command")?.removeEventListener(it) }
        } catch (_: Exception) {}
        roomValueEventListener = null
        commandEventListener = null
        localSongsEventListener = null
        iptvCommandEventListener = null

        hasActiveSongPlaying = false
        isOfflineActive = false
        isSoundCloudSession = false
        isPlaying = false

        stopExoCompletely(hideHost = true, keepArtwork = false)
        releasePlay1080Completely()

        exoPlayer?.let { player ->
            try {
                player.release()
            } catch (_: Exception) {}
        }
        exoPlayer = null
        playerView?.player = null

        try {
            finishAndRemoveTask()
        } catch (_: Exception) {
            try {
                finishAffinity()
            } catch (_: Exception) {
                finish()
            }
        }

        Process.killProcess(Process.myPid())
        System.exit(0)
    }

