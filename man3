    private fun pushIptvChannelsToFirebase(dsKenh: List<iptvmanager.KenhIptv>) {
        if (isExitingApp) return
        val targetRef = roomRef ?: database.getReference("rooms/$currentRoomId")
        val mapChannels = LinkedHashMap<String, Any>()
        dsKenh.forEach { kenh ->
            mapChannels[kenh.index.toString()] = mapOf<String, Any>(
                "index" to kenh.index,
                "number" to kenh.soKenh,
                "name" to kenh.tenKenh,
                "logo" to kenh.logo,
                "url" to kenh.streamUrl,
                "group" to kenh.nhom,
                "clearKey" to kenh.clearKey,
                "date" to kenh.date,
                "userAgent" to kenh.userAgent,
                "referer" to kenh.referer,
                "proxyUrl" to kenh.proxyUrl,
                "hasClearKey" to kenh.clearKey.isNotBlank()
            )
        }

        targetRef.child("iptv_channels")
            .setValue(mapChannels)
            .addOnFailureListener { err ->
                Log.e("KARA_IPTV", "Lỗi đẩy iptv_channels lên Firebase: ${err.message}")
            }
    }

    private fun bindIptvRemoteListener() {
        if (isExitingApp) return
        val targetRef = roomRef ?: database.getReference("rooms/$currentRoomId")
        iptvCommandEventListener?.let {
            try {
                targetRef.child("iptv_command").removeEventListener(it)
            } catch (_: Exception) {}
        }

        lastIptvCommandTimestamp = 0L
        val listener = object : ValueEventListener {
            override fun onDataChange(snapshot: DataSnapshot) {
                if (isExitingApp || isFinishing || isDestroyed || !snapshot.exists()) return

                val timestamp = snapshot.child("timestamp").getValue(Long::class.java) ?: 0L
                if (timestamp <= lastIptvCommandTimestamp) return
                lastIptvCommandTimestamp = timestamp

                val action = snapshot.child("action").getValue(String::class.java).orEmpty().ifBlank { "play" }
                val indexRemote = snapshot.child("index").getValue(Int::class.java) ?: -1
                val numberRemote = snapshot.child("number").getValue(Int::class.java) ?: -1

                runAfterOfflineScan {
                    if (isExitingApp || isFinishing || isDestroyed) return@runAfterOfflineScan
                    when (action) {
                        "channel_up" -> {
                            iptvmanager.phatKenhTruocDo(
                                exoPlayer = exoPlayer,
                                onBatDauPhat = { kenh -> prepareHostForIptvPlayback(kenh) },
                                onLoi = { errMsg -> showToast("⚠️ $errMsg") }
                            )
                        }
                        "channel_down" -> {
                            iptvmanager.phatKenhKeTiep(
                                exoPlayer = exoPlayer,
                                onBatDauPhat = { kenh -> prepareHostForIptvPlayback(kenh) },
                                onLoi = { errMsg -> showToast("⚠️ $errMsg") }
                            )
                        }
                        else -> {
                            val kenhTimThay = iptvmanager.timKenhTheoViTriHoacSo(indexRemote, numberRemote)
                            if (kenhTimThay != null) {
                                playIptvChannelImmediately(kenhTimThay)
                            } else {
                                val urlFallback = snapshot.child("url").getValue(String::class.java).orEmpty()
                                if (urlFallback.isNotBlank()) {
                                    val kenhTam = iptvmanager.KenhIptv(
                                        index = if (indexRemote >= 0) indexRemote else 0,
                                        soKenh = if (numberRemote >= 1) numberRemote else 1,
                                        tenKenh = snapshot.child("name").getValue(String::class.java).orEmpty().ifBlank { "Kênh IPTV" },
                                        streamUrl = urlFallback,
                                        nhom = snapshot.child("group").getValue(String::class.java).orEmpty().ifBlank { "Truyền hình" },
                                        logo = snapshot.child("logo").getValue(String::class.java).orEmpty(),
                                        clearKey = snapshot.child("clearKey").getValue(String::class.java).orEmpty(),
                                        date = snapshot.child("date").getValue(String::class.java).orEmpty(),
                                        userAgent = snapshot.child("userAgent").getValue(String::class.java).orEmpty(),
                                        referer = snapshot.child("referer").getValue(String::class.java).orEmpty(),
                                        proxyUrl = snapshot.child("proxyUrl").getValue(String::class.java).orEmpty()
                                    )
                                    playIptvChannelImmediately(kenhTam)
                                }
                            }
                        }
                    }
                }
            }

            override fun onCancelled(error: DatabaseError) {
                Log.e("KARA_IPTV", "Lỗi lắng nghe iptv_command: ${error.message}")
            }
        }

        iptvCommandEventListener = listener
        targetRef.child("iptv_command").addValueEventListener(listener)
    }

    private fun bindChannelLogo(imageView: ImageView, rawLogoUrl: String) {
        val cleanUrl = rawLogoUrl.trim()
        if (cleanUrl.isBlank()) {
            imageView.tag = null
            imageView.visibility = View.GONE
            imageView.setImageDrawable(null)
            return
        }

        val cached = logoBitmapCache[cleanUrl]
        if (cached != null && !cached.isRecycled) {
            imageView.tag = cleanUrl
            imageView.setImageBitmap(cached)
            imageView.visibility = View.VISIBLE
            return
        }

        imageView.visibility = View.GONE
        imageView.tag = cleanUrl

        if (logoLoaderExecutor.isShutdown) return
        logoLoaderExecutor.execute {
            if (isExitingApp || isFinishing || isDestroyed || logoLoaderExecutor.isShutdown) return@execute
            try {
                val safeUrl = if (cleanUrl.startsWith("http://")) {
                    cleanUrl.replaceFirst("http://", "https://")
                } else {
                    cleanUrl
                }
                val conn = (URL(safeUrl).openConnection() as HttpURLConnection).apply {
                    connectTimeout = 5000
                    readTimeout = 6000
                    instanceFollowRedirects = true
                    setRequestProperty("User-Agent", "Mozilla/5.0")
                }
                val opts = BitmapFactory.Options().apply {
                    inSampleSize = 2
                }
                val bmp = conn.inputStream.use { input -> BitmapFactory.decodeStream(input, null, opts) }
                try { conn.disconnect() } catch (_: Exception) {}

                if (bmp != null && !isExitingApp && !isFinishing && !isDestroyed) {
                    if (logoBitmapCache.size > 200) {
                        logoBitmapCache.clear()
                    }
                    logoBitmapCache[cleanUrl] = bmp
                    runOnUiThread {
                        if (!isExitingApp && !isFinishing && !isDestroyed && imageView.tag == cleanUrl && !bmp.isRecycled) {
                            imageView.setImageBitmap(bmp)
                            imageView.visibility = View.VISIBLE
                        }
                    }
                }
            } catch (_: Exception) {
            }
        }
    }

