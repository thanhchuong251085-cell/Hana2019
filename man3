    private fun releasePlay1080Completely() {
        val view = play1080 ?: return
        try {
            view.keepScreenOn = false
        } catch (_: Exception) {}
        try {
            view.setPaused(true)
        } catch (_: Exception) {}
        try {
            view.stopForOffline()
        } catch (_: Exception) {}
        try {
            view.visibility = View.GONE
        } catch (_: Exception) {}

        for (methodName in listOf("release", "destroy", "onDestroy", "stopPlayback")) {
            try {
                val method = view.javaClass.getMethod(methodName)
                method.invoke(view)
            } catch (_: NoSuchMethodException) {
            } catch (_: Exception) {}
        }
        try {
            (view.parent as? ViewGroup)?.removeView(view)
        } catch (_: Exception) {}
        play1080 = null
    }

