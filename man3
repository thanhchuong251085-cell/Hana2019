    private fun formatTimeMs(ms: Long): String {
        val totalSec = (ms.coerceAtLeast(0L)) / 1000L
        val mins = totalSec / 60L
        val secs = totalSec % 60L
        return String.format(Locale.US, "%02d:%02d", mins, secs)
    }

