    private fun isPrioritySong(song: SongData): Boolean {
        val flagKeys = listOf("priority", "isPriority", "urgent", "isUrgent", "topQueue", "isTop")
        for (k in flagKeys) {
            val v = song[k]
            if (v is Boolean && v) return true
            if (v is Number && v.toInt() > 0) return true
            if (v is String && (v.equals("true", true) || v.equals("priority", true) || v == "1")) return true
        }
        val mode = (song["mode"] ?: song["queueMode"] ?: song["action"] ?: song["typeSend"] ?: "")
            .toString().lowercase(Locale.US)
        if (mode == "priority" || mode == "prioritize" || mode == "top" || mode == "uu_tien") return true

        val prioSeq = (song["prioritySeq"] as? Number)?.toLong() ?: 0L
        return prioSeq > 0L
    }

    private fun extractLongValue(map: SongData, vararg keys: String): Long {
        for (k in keys) {
            val v = map[k]
            if (v is Number) {
                val l = v.toLong()
                if (l != 0L) return l
            }
        }
        return 0L
    }

    private fun sortQueueItems(items: MutableList<SongData>) {
        items.sortWith { a, b ->
            val pa = isPrioritySong(a)
            val pb = isPrioritySong(b)
            when {
                pa && !pb -> -1
                !pa && pb -> 1
                pa && pb -> {
                    val seqA = extractLongValue(a, "prioritySeq", "priorityTime", "clientTimestamp", "timestamp")
                    val seqB = extractLongValue(b, "prioritySeq", "priorityTime", "clientTimestamp", "timestamp")
                    seqB.compareTo(seqA)
                }
                else -> {
                    val timeA = extractLongValue(a, "clientTimestamp", "timestamp")
                    val timeB = extractLongValue(b, "clientTimestamp", "timestamp")
                    timeA.compareTo(timeB)
                }
            }
        }
    }

    private fun isVideoMedia(song: SongData, url: String, title: String, localKey: String): Boolean {
        val explicitFlag = song["isVideo"]
        if (explicitFlag is Boolean) return explicitFlag
        if (explicitFlag is String && explicitFlag.isNotBlank()) {
            return explicitFlag.equals("true", ignoreCase = true)
        }
        val mediaType = (song["mediaType"] ?: "").toString().lowercase(Locale.US)
        if (mediaType == "video") return true
        if (mediaType == "audio") return false

        if (localKey.isNotEmpty() && localIsVideoMap.containsKey(localKey)) {
            return localIsVideoMap[localKey] == true
        }

        val lowerUrl = url.lowercase(Locale.US)
        if (lowerUrl.contains("/video/")) return true
        if (lowerUrl.contains("/audio/")) return false

        val lowerTitle = title.lowercase(Locale.US)
        return SUPPORTED_VIDEO_EXTS.any { ext ->
            lowerUrl.endsWith(".$ext") || lowerUrl.contains(".$ext?") || lowerTitle.endsWith(".$ext")
        }
    }

