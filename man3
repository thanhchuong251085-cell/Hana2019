    private fun normalizeMediaDedupeKey(title: String, url: String): String {
        val cleanUrl = url.trim().lowercase(Locale.US)
        if (cleanUrl.isNotBlank()) return "url:$cleanUrl"
        val cleanTitle = title.trim().lowercase(Locale.US)
        return "title:$cleanTitle"
    }

    private fun deduplicateScannedMedia(items: List<ScannedLocalMedia>): List<ScannedLocalMedia> {
        val result = ArrayList<ScannedLocalMedia>(items.size)
        val seenKeys = HashSet<String>()
        for (item in items) {
            val cleanTitle = item.title.trim()
            val cleanUrl = item.url.trim()
            if (cleanUrl.isEmpty() && cleanTitle.isEmpty()) continue
            val key = normalizeMediaDedupeKey(cleanTitle, cleanUrl)
            if (seenKeys.add(key)) {
                result.add(item.copy(title = cleanTitle.ifEmpty { "Bài hát offline" }, url = cleanUrl))
            }
        }
        return result
    }

    private fun deduplicateSongMapList(rawItems: List<SongData>): List<SongData> {
        val uniqueList = ArrayList<SongData>(rawItems.size)
        val seenKeys = HashSet<String>()
        for (song in rawItems) {
            val title = (song["title"] ?: song["name"] ?: "").toString().trim()
            val url = (song["url"] ?: "").toString().trim()
            val localKey = (song["localKey"] ?: "").toString().trim()
            val key = when {
                url.isNotEmpty() -> "url:${url.lowercase(Locale.US)}"
                localKey.isNotEmpty() -> "key:${localKey.lowercase(Locale.US)}"
                title.isNotEmpty() -> "title:${title.lowercase(Locale.US)}"
                else -> continue
            }
            if (seenKeys.add(key)) {
                uniqueList.add(song)
            }
        }
        return uniqueList
    }

    private fun isSupportedMediaFile(displayName: String?, mimeType: String?, isVideoCollection: Boolean): Boolean {
        val ext = displayName
            ?.substringAfterLast('.', "")
            ?.lowercase(Locale.US)
            .orEmpty()
        val mime = mimeType?.lowercase(Locale.US).orEmpty()

        return if (isVideoCollection) {
            SUPPORTED_VIDEO_EXTS.contains(ext) || mime.startsWith("video/")
        } else {
            SUPPORTED_AUDIO_EXTS.contains(ext) || mime.startsWith("audio/")
        }
    }

    private fun scanDeviceMediaFiles(): List<ScannedLocalMedia> {
        val found = ArrayList<ScannedLocalMedia>()
        val seenUrls = HashSet<String>()

        fun queryCollection(collectionUri: Uri, isVideo: Boolean) {
            val idCol = MediaStore.MediaColumns._ID
            val titleCol = MediaStore.MediaColumns.TITLE
            val displayNameCol = MediaStore.MediaColumns.DISPLAY_NAME
            val mimeCol = MediaStore.MediaColumns.MIME_TYPE
            val projection = arrayOf(idCol, titleCol, displayNameCol, mimeCol)

            try {
                contentResolver.query(
                    collectionUri,
                    projection,
                    null,
                    null,
                    "${MediaStore.MediaColumns.DATE_ADDED} DESC"
                )?.use { cursor ->
                    val idIdx = cursor.getColumnIndex(idCol)
                    val titleIdx = cursor.getColumnIndex(titleCol)
                    val nameIdx = cursor.getColumnIndex(displayNameCol)
                    val mimeIdx = cursor.getColumnIndex(mimeCol)

                    while (cursor.moveToNext()) {
                        val id = if (idIdx != -1) cursor.getLong(idIdx) else -1L
                        if (id <= 0L) continue

                        val rawName = if (nameIdx != -1) cursor.getString(nameIdx) else null
                        val rawMime = if (mimeIdx != -1) cursor.getString(mimeIdx) else null
                        if (!isSupportedMediaFile(rawName, rawMime, isVideo)) continue

                        val contentUri = ContentUris.withAppendedId(collectionUri, id).toString()
                        if (!seenUrls.add(contentUri)) continue

                        val rawTitle = if (titleIdx != -1) cursor.getString(titleIdx) else null
                        val label = when {
                            !rawTitle.isNullOrBlank() -> rawTitle.trim()
                            !rawName.isNullOrBlank() -> rawName.trim()
                            else -> if (isVideo) "Video offline" else "Nhạc offline"
                        }
                        found.add(ScannedLocalMedia(title = label, url = contentUri, isVideo = isVideo))
                    }
                }
            } catch (e: Exception) {
                Log.e("KARA_SCAN", "Lỗi quét bộ nhớ ($isVideo): ${e.message}")
            }
        }

        queryCollection(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, isVideo = false)
        queryCollection(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, isVideo = true)
        return deduplicateScannedMedia(found)
    }

    private fun scanAllDeviceMediaWithFlag() {
        if (isExitingApp || isFinishing || isDestroyed) return
        if (isOfflineScanInProgress) {
            showToast("⏳ Đang quét file, vui lòng chờ...")
            return
        }

        markOfflineScanStarted()
        showToast("🔍 Đang quét toàn bộ file nhạc & video trên máy...")

        if (mediaBackgroundExecutor.isShutdown) {
            finishOfflineScanFlagAndRunPending()
            return
        }

        mediaBackgroundExecutor.execute {
            try {
                val scanned = scanDeviceMediaFiles()
                runOnUiThread {
                    try {
                        if (!isExitingApp && !isFinishing && !isDestroyed) {
                            if (scanned.isNotEmpty()) {
                                sendSelectedOfflineSongsToFirebase(scanned)
                            } else {
                                showToast("⚠️ Không tìm thấy tệp nhạc/video nào")
                            }
                        }
                    } finally {
                        finishOfflineScanFlagAndRunPending()
                    }
                }
            } catch (e: Exception) {
                Log.e("KARA_SCAN", "Lỗi quét bộ nhớ: ${e.message}")
                runOnUiThread {
                    try {
                        if (!isExitingApp && !isFinishing && !isDestroyed) {
                            showToast("⚠️ Lỗi khi quét bộ nhớ")
                        }
                    } finally {
                        finishOfflineScanFlagAndRunPending()
                    }
                }
            }
        }
    }

    private fun openOfflineFolderViaPicker() {
        if (isExitingApp || isFinishing || isDestroyed) return
        if (isOfflineScanInProgress) {
            showToast("⏳ Đang quét nhạc offline, vui lòng chờ...")
            return
        }

        markOfflineScanStarted()
        try {
            OfflineFolderPicker.showFullscreenPicker(
                activity = this,
                currentDialogRef = offlineFolderDialog,
                onDialogCreated = { created ->
                    offlineFolderDialog = created
                    created.setOnDismissListener {
                        if (offlineFolderDialog === created) {
                            offlineFolderDialog = null
                        }
                        finishOfflineScanFlagAndRunPending()
                    }
                },
                onOpenFileManager = {
                    OfflineFolderPicker.launchExternalFileManagerChooser(
                        activity = this,
                        launcher = externalFilePickerLauncher,
                        onUnavailable = {
                            finishOfflineScanFlagAndRunPending()
                            showToast("⚠️ Không mở được trình quản lý file")
                        }
                    )
                },
                onShowToast = { msg -> showToast(msg) },
                onConfirmSelection = { pickedList ->
                    try {
                        sendSelectedOfflineSongsToFirebase(pickedList)
                    } finally {
                        finishOfflineScanFlagAndRunPending()
                    }
                }
            )
        } catch (e: Exception) {
            Log.e("KARA_OFFLINE", "Lỗi mở OfflineFolderPicker: ${e.message}")
            finishOfflineScanFlagAndRunPending()
            showToast("⚠️ Không mở được trình chọn nhạc offline")
        }
    }

    private fun loadPersistedIptvLinks() {
        val prefs = getSharedPreferences(PREFS_IPTV, Context.MODE_PRIVATE)
        savedIptvLinks.clear()

        val rawJson = prefs.getString(KEY_IPTV_SAVED_LIST, null)
        if (!rawJson.isNullOrBlank()) {
            try {
                val arr = JSONArray(rawJson)
                for (i in 0 until arr.length()) {
                    val item = arr.optString(i, "").trim()
                    if (item.isNotBlank() && !savedIptvLinks.contains(item)) {
                        savedIptvLinks.add(item)
                    }
                }
            } catch (_: Exception) {}
        }

        val activeUrl = prefs.getString(KEY_IPTV_ACTIVE_URL, "").orEmpty().trim()
        if (activeUrl.isNotBlank()) {
            savedIptvPlaylistUrl = activeUrl
            if (!savedIptvLinks.contains(activeUrl)) {
                savedIptvLinks.add(0, activeUrl)
                savePersistedIptvLinks()
            }
        } else if (savedIptvLinks.isNotEmpty()) {
            savedIptvPlaylistUrl = savedIptvLinks.first()
        } else {
            savedIptvPlaylistUrl = ""
        }
    }

    private fun savePersistedIptvLinks() {
        val arr = JSONArray()
        savedIptvLinks.forEach { link ->
            if (link.isNotBlank()) arr.put(link)
        }
        getSharedPreferences(PREFS_IPTV, Context.MODE_PRIVATE)
            .edit()
            .putString(KEY_IPTV_SAVED_LIST, arr.toString())
            .putString(KEY_IPTV_ACTIVE_URL, savedIptvPlaylistUrl)
            .apply()
    }

    private fun addOrPromoteIptvLink(rawUrl: String, setAsActive: Boolean) {
        val clean = rawUrl.trim()
        if (clean.isBlank()) return

        savedIptvLinks.remove(clean)
        savedIptvLinks.add(0, clean)

        if (setAsActive) {
            savedIptvPlaylistUrl = clean
        }
        savePersistedIptvLinks()
    }

    private fun removeSavedIptvLink(targetUrl: String) {
        savedIptvLinks.remove(targetUrl)
        if (savedIptvPlaylistUrl == targetUrl) {
            savedIptvPlaylistUrl = savedIptvLinks.firstOrNull().orEmpty()
        }
        savePersistedIptvLinks()
    }

    private fun loadIptvPlaylistFromUrl(
        urlInput: String,
        onStart: (() -> Unit)? = null,
        onSuccess: ((List<iptvmanager.KenhIptv>) -> Unit)? = null,
        onError: ((String) -> Unit)? = null
    ) {
        val cleanUrl = urlInput.trim()
        if (cleanUrl.isBlank()) {
            onError?.invoke("Vui lòng nhập link IPTV")
            return
        }

        runAfterOfflineScan {
            if (isExitingApp || isFinishing || isDestroyed) return@runAfterOfflineScan
            savedIptvPlaylistUrl = cleanUrl
            addOrPromoteIptvLink(cleanUrl, setAsActive = true)
            onStart?.invoke()

            bindIptvRemoteListener()
            iptvmanager.taiDanhSachKenh(
                playlistUrl = cleanUrl,
                onThanhCong = { dsKenh ->
                    if (isExitingApp || isFinishing || isDestroyed) return@taiDanhSachKenh
                    cachedIptvChannels = dsKenh
                    pushIptvChannelsToFirebase(dsKenh)
                    onSuccess?.invoke(dsKenh)
                },
                onLoi = { loi ->
                    if (isExitingApp || isFinishing || isDestroyed) return@taiDanhSachKenh
                    onError?.invoke(loi)
                }
            )
        }
    }

