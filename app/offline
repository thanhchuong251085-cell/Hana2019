                }
            }
            styleTab(btnFilterAll, filterMode == "all")
            styleTab(btnFilterVideo, filterMode == "video")
            styleTab(btnFilterAudio, filterMode == "audio")
        }

        fun updateSourceButtonsStyle() {
            sourceButtons.forEach { (src, tv) ->
                val active = src.id == activeSource.id
                tv.setTextColor(if (active) Color.BLACK else Color.WHITE)
                tv.background = GradientDrawable().apply {
                    shape = GradientDrawable.RECTANGLE
                    cornerRadius = 6.dp(activity).toFloat()
                    setColor(if (active) Color.parseColor("#FFDD00") else Color.parseColor("#2C2F38"))
                }
            }
        }

        fun renderItemsList() {
            listContainer.removeAllViews()
            val shown = getFilteredList()

            if (isScanningNow) {
                tvStatusBanner.text = "⏳ Đang quét ${activeSource.label}..."
                return
            }

            if (shown.isEmpty()) {
                val msg = if (activeSource.rootPaths.isEmpty()) {
                    "Không phát hiện ${activeSource.label} hoặc chưa có tệp nào trong ${activeSource.label}."
                } else {
                    "Không có tệp nào trong ${activeSource.label}."
                }
                tvStatusBanner.text = msg
                val emptyTv = TextView(activity).apply {
                    text = msg
                    setTextColor(Color.parseColor("#9E9E9E"))
                    textSize = 13f
                    gravity = Gravity.CENTER
                    setPadding(0, 48.dp(activity), 0, 24.dp(activity))
                }
                listContainer.addView(emptyTv)
                return
            }

            tvStatusBanner.text = "${activeSource.label}: ${shown.size} tệp (đã chọn ${selectedUrls.size})"

            shown.forEachIndexed { idx, item ->
                val isChecked = selectedUrls.contains(item.url)
                val row = LinearLayout(activity).apply {
                    orientation = LinearLayout.HORIZONTAL
                    gravity = Gravity.CENTER_VERTICAL
                    setPadding(10.dp(activity), 7.dp(activity), 10.dp(activity), 7.dp(activity))
                    layoutParams = LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.MATCH_PARENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT
                    ).apply { bottomMargin = 6.dp(activity) }
                    background = GradientDrawable().apply {
                        shape = GradientDrawable.RECTANGLE
                        cornerRadius = 7.dp(activity).toFloat()
                        setColor(if (isChecked) Color.parseColor("#294D3E") else Color.parseColor("#242730"))
                        setStroke(1, if (isChecked) Color.parseColor("#26A67A") else Color.parseColor("#38FFFFFF"))
                    }
                }

                val tvCheck = TextView(activity).apply {
                    text = if (isChecked) "☑" else "☐"
                    setTextColor(if (isChecked) Color.parseColor("#00E699") else Color.parseColor("#CFD8DC"))
                    textSize = 15f
                    layoutParams = LinearLayout.LayoutParams(
                        LinearLayout.LayoutParams.WRAP_CONTENT,
                        LinearLayout.LayoutParams.WRAP_CONTENT
                    ).apply { rightMargin = 8.dp(activity) }
                }

                val badge = if (item.isVideo) "🎬" else "🎵"
                val tvTitle = TextView(activity).apply {
                    text = "${idx + 1}. $badge ${item.title}"
                    setTextColor(Color.WHITE)
                    textSize = 12.5f
                    maxLines = 1
                    ellipsize = TextUtils.TruncateAt.END
                    layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
                }

                row.addView(tvCheck)
                row.addView(tvTitle)
                row.setOnClickListener {
                    if (selectedUrls.contains(item.url)) {
                        selectedUrls.remove(item.url)
                    } else {
                        selectedUrls.add(item.url)
                    }
                    renderItemsList()
                }
                listContainer.addView(row)
            }
        }

        fun runScanForActiveSource() {
            if (isScanningNow || scanExecutor.isShutdown) return
            isScanningNow = true
            selectedUrls.clear()
            scannedItems = emptyList()
            renderItemsList()

            val targetSource = activeSource
            scanExecutor.execute {
                val rawFound = try {
                    scanSingleSourceOnce(activity, targetSource)
                } catch (e: Exception) {
                    Log.e("KARA_SCAN", "Scan error (${targetSource.label}): ${e.message}")
                    emptyList()
                }

                val finalList = deduplicateMediaStrict(rawFound)

                mainHandler.post {
                    if (!dialog.isShowing || activity.isFinishing || activity.isDestroyed) return@post
                    isScanningNow = false
                    scannedItems = finalList
                    renderItemsList()
                }
            }
        }

        sources.forEach { src ->
            val srcBtn = TextView(activity).apply {
                text = src.label
                textSize = 11.5f
                setTypeface(null, Typeface.BOLD)
                setPadding(10.dp(activity), 5.dp(activity), 10.dp(activity), 5.dp(activity))
                layoutParams = LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT
                ).apply { rightMargin = 6.dp(activity) }
                setOnClickListener {
                    if (isScanningNow) return@setOnClickListener
                    activeSource = src
                    updateSourceButtonsStyle()
                    runScanForActiveSource()
                }
            }
            sourceButtons.add(src to srcBtn)
            sourceRow.addView(srcBtn)
        }

        btnFilterAll.setOnClickListener {
            filterMode = "all"
            updateFilterButtonsStyle()
            renderItemsList()
        }
        btnFilterVideo.setOnClickListener {
            filterMode = "video"
            updateFilterButtonsStyle()
            renderItemsList()
        }
        btnFilterAudio.setOnClickListener {
            filterMode = "audio"
            updateFilterButtonsStyle()
            renderItemsList()
        }
        btnRescan.setOnClickListener {
            runScanForActiveSource()
        }
        btnSelectAll.setOnClickListener {
            val shown = getFilteredList()
            if (shown.isEmpty()) return@setOnClickListener
            val allSelected = shown.all { selectedUrls.contains(it.url) }
            if (allSelected) {
                shown.forEach { selectedUrls.remove(it.url) }
            } else {
                shown.forEach { selectedUrls.add(it.url) }
            }
            renderItemsList()
        }
        btnSend.setOnClickListener {
            val picked = deduplicateMediaStrict(scannedItems.filter { selectedUrls.contains(it.url) })
            if (picked.isEmpty()) {
                onShowToast("⚠️ Vui lòng chọn ít nhất 1 bài")
                return@setOnClickListener
            }
            dialog.dismiss()
            onConfirmSelection(picked)
        }

        mainColumn.addView(sourceRow)
        mainColumn.addView(tvStatusBanner)
        mainColumn.addView(scrollArea)

        bottomBar.addView(btnFileManager)
        bottomBar.addView(btnRescan)
        bottomBar.addView(btnSelectAll)
        bottomBar.addView(spacer)
        bottomBar.addView(btnSend)
        bottomBar.addView(btnClose)
        mainColumn.addView(bottomBar)

        root.addView(mainColumn)
        dialog.setContentView(root)

        updateFilterButtonsStyle()
        updateSourceButtonsStyle()

        dialog.show()
        onDialogCreated(dialog)
        runScanForActiveSource()
    }
}
