object OfflineFolderPicker {
    private val AUDIO_EXTS = setOf(
        "mp3", "wav", "m4a", "aac", "ogg", "flac", "wma", "opus", "amr", "aiff", "mid", "midi", "3ga", "ac3", "dts"
    )
    private val VIDEO_EXTS = setOf(
        "mp4", "mkv", "webm", "avi", "mov", "flv", "3gp", "m4v", "ts", "mpg", "mpeg", "vob", "divx", "rmvb", "wmv"
    )

    private val BLOCKED_DIR_NAMES = setOf(
        "android", "data", "obb", "proc", "sys", "dev", "acct", "config", "cache",
        "lost+found", "system", "vendor", "product", "odm", "root", "etc", "bin",
        "sbin", "lib", "lib64", "mnt", "storage", "firmware", "security", "recovery"
    )

    private val PREFERRED_USER_DIRS = listOf(
        "Music", "Movies", "Movie", "Video", "Videos", "Download", "Downloads",
        "DCIM", "Pictures", "Karaoke", "Nhac", "Phim", "Audio"
    )

    private const val MAX_SCAN_DEPTH = 5

    private val scanExecutor = Executors.newSingleThreadExecutor()
    private val mainHandler = Handler(Looper.getMainLooper())

    private fun Int.dp(ctx: Context): Int = (this * ctx.resources.displayMetrics.density).toInt()

    private fun hasReadMediaPermissions(context: Context): Boolean {
        val required = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            listOf(
                Manifest.permission.READ_MEDIA_AUDIO,
                Manifest.permission.READ_MEDIA_VIDEO
            )
        } else {
            listOf(Manifest.permission.READ_EXTERNAL_STORAGE)
        }
        return required.all {
            ContextCompat.checkSelfPermission(context, it) == PackageManager.PERMISSION_GRANTED
        }
    }

    private fun requestReadMediaPermissionsIfNeeded(activity: Activity, onDone: () -> Unit) {
        if (hasReadMediaPermissions(activity)) {
            onDone()
            return
        }
        val required = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            arrayOf(
                Manifest.permission.READ_MEDIA_AUDIO,
                Manifest.permission.READ_MEDIA_VIDEO
            )
        } else {
            arrayOf(Manifest.permission.READ_EXTERNAL_STORAGE)
        }
        ActivityCompat.requestPermissions(activity, required, 9103)
        mainHandler.postDelayed({
            if (!activity.isFinishing && !activity.isDestroyed) {
                onDone()
            }
        }, 700L)
    }

    private fun safeCanonical(raw: String): String {
        val noScheme = raw.trim().removePrefix("file://").trimEnd('/')
        if (noScheme.isEmpty()) return ""
        return try {
            File(noScheme).canonicalPath.trimEnd('/')
        } catch (_: Exception) {
            try {
                File(noScheme).absolutePath.trimEnd('/')
            } catch (_: Exception) {
                noScheme
            }
        }
    }

    private fun normLower(raw: String): String = safeCanonical(raw).lowercase(Locale.US)

    private fun isUnderAnyRoot(filePath: String, roots: List<String>): Boolean {
        if (roots.isEmpty()) return false
        val f = normLower(filePath)
        if (f.isEmpty()) return false
        return roots.any { r ->
            val root = normLower(r)
            root.isNotEmpty() && (f == root || f.startsWith("$root/"))
        }
    }

    private fun isBlockedSystemOrHiddenPath(fileOrDir: File, rootCanon: String): Boolean {
        val nameLower = fileOrDir.name.lowercase(Locale.US)
        if (nameLower.isBlank() || nameLower.startsWith(".") || nameLower in BLOCKED_DIR_NAMES) {
            return true
        }
        val canon = safeCanonical(fileOrDir.absolutePath)
        val normCanon = canon.lowercase(Locale.US)
        val normRoot = safeCanonical(rootCanon).lowercase(Locale.US)
        if (normRoot.isNotEmpty() && normCanon.startsWith("$normRoot/")) {
            val rel = normCanon.removePrefix("$normRoot/")
            for (seg in rel.split("/")) {
                if (seg.startsWith(".") || seg in BLOCKED_DIR_NAMES) {
                    return true
                }
            }
        }
        return false
    }

    private fun detectMediaType(nameOrPath: String, mimeType: String?): Boolean? {
        val mime = mimeType?.lowercase(Locale.US).orEmpty()
        if (mime.startsWith("video/")) return true
        if (mime.startsWith("audio/")) return false

        val clean = nameOrPath.substringBefore("?").lowercase(Locale.US)
        val ext = clean.substringAfterLast('.', "")
        if (ext in VIDEO_EXTS) return true
        if (ext in AUDIO_EXTS) return false
        return null
    }

    /**
     * Khử trùng lặp tuyệt đối: có N file thật -> trả về đúng N file, không nhân bản.
     */
    private fun deduplicateMediaStrict(items: List<ScannedLocalMedia>): List<ScannedLocalMedia> {
        val uniqueByKey = LinkedHashMap<String, ScannedLocalMedia>()
        for (item in items) {
            val rawUrl = item.url.trim()
            val canonPath = normLower(rawUrl)
            val key = when {
                rawUrl.startsWith("content://", ignoreCase = true) -> rawUrl.lowercase(Locale.US)
                canonPath.isNotEmpty() -> canonPath
                else -> "${item.title.trim().lowercase(Locale.US)}|${item.isVideo}|${rawUrl.lowercase(Locale.US)}"
            }
            if (key.isNotEmpty() && !uniqueByKey.containsKey(key)) {
                uniqueByKey[key] = item
            }
        }
        return uniqueByKey.values.toList()
    }

    private fun discoverStorageSources(context: Context): List<StorageSource> {
        val internalRoots = LinkedHashSet<String>()
        val sdCardRoots = LinkedHashSet<String>()
        val usbRoots = LinkedHashSet<String>()

        try {
            @Suppress("DEPRECATION")
            val primaryDir = Environment.getExternalStorageDirectory()
            val c = primaryDir?.absolutePath?.let { safeCanonical(it) }.orEmpty()
            if (c.isNotEmpty()) internalRoots.add(c)
        } catch (_: Exception) {}

        internalRoots.add("/storage/emulated/0")

        try {
            val sm = context.getSystemService(Context.STORAGE_SERVICE) as? StorageManager
            if (sm != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
                for (vol in sm.storageVolumes) {
                    if (vol.state != Environment.MEDIA_MOUNTED && vol.state != Environment.MEDIA_MOUNTED_READ_ONLY) {
                        continue
                    }
                    var rawVolPath: String? = null
                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                        rawVolPath = vol.directory?.absolutePath
                    }
                    if (rawVolPath.isNullOrBlank()) {
                        try {
                            val m = vol.javaClass.getMethod("getPath")
                            rawVolPath = m.invoke(vol)?.toString()
                        } catch (_: Exception) {}
                    }
                    val canonPath = rawVolPath?.let { safeCanonical(it) }.orEmpty()
                    if (canonPath.isEmpty()) continue

                    if (vol.isPrimary) {
                        internalRoots.add(canonPath)
                    } else {
                        val desc = vol.getDescription(context)?.lowercase(Locale.US).orEmpty()
                        val pathLower = canonPath.lowercase(Locale.US)
                        val isRemovable = try { vol.isRemovable } catch (_: Exception) { true }
                        if (desc.contains("usb") || pathLower.contains("usb")) {
                            usbRoots.add(canonPath)
                        } else if (isRemovable) {
                            sdCardRoots.add(canonPath)
                        } else {
                            internalRoots.add(canonPath)
                        }
                    }
                }
            }
        } catch (e: Exception) {
            Log.e("KARA_SCAN", "StorageVolumes error: ${e.message}")
        }

        val knownAll = LinkedHashSet<String>().apply {
            addAll(internalRoots)
            addAll(sdCardRoots)
            addAll(usbRoots)
        }

        for (mountBase in listOf("/storage", "/mnt/media_rw")) {
            val dir = File(mountBase)
            if (!dir.exists() || !dir.isDirectory) continue
            try {
                dir.listFiles()?.forEach { child ->
                    if (!child.isDirectory) return@forEach
                    val lowerName = child.name.lowercase(Locale.US)
                    if (lowerName == "emulated" || lowerName == "self" || lowerName == "sdcard0") return@forEach
                    val canon = safeCanonical(child.absolutePath)
                    if (canon.isEmpty() || canon in knownAll) return@forEach

                    if (lowerName.contains("usb") || mountBase.contains("usb")) {
                        usbRoots.add(canon)
                    } else {
                        sdCardRoots.add(canon)
                    }
                    knownAll.add(canon)
                }
            } catch (_: Exception) {}
        }

        val intList = internalRoots.toList()
        val sdList = sdCardRoots.filter { !isUnderAnyRoot(it, intList) }.distinct()
        val usbList = usbRoots.filter { !isUnderAnyRoot(it, intList) && !isUnderAnyRoot(it, sdList) }.distinct()
        val allList = (intList + sdList + usbList).distinct()

        return listOf(
            StorageSource(
                id = "all_disks",
                label = "Quét ổ đĩa",
                rootPaths = allList,
                forbiddenPaths = emptyList(),
                isAllDisks = true
            ),
            StorageSource(
                id = "internal",
                label = "Bộ nhớ trong",
                rootPaths = intList,
                forbiddenPaths = sdList + usbList,
                isAllDisks = false
            ),
            StorageSource(
                id = "sdcard",
                label = "Thẻ nhớ",
                rootPaths = sdList,
                forbiddenPaths = intList + usbList,
                isAllDisks = false
            ),
            StorageSource(
                id = "usb",
                label = "USB",
                rootPaths = usbList,
                forbiddenPaths = intList + sdList,
                isAllDisks = false
            )
        )
    }

    private fun belongsStrictlyToSource(filePath: String, source: StorageSource): Boolean {
        if (source.rootPaths.isEmpty()) return false
        if (!isUnderAnyRoot(filePath, source.rootPaths)) return false
        if (!source.isAllDisks && source.forbiddenPaths.isNotEmpty()) {
            if (isUnderAnyRoot(filePath, source.forbiddenPaths)) return false
        }
        return true
    }

    private fun scanSingleSourceOnce(context: Context, source: StorageSource): List<ScannedLocalMedia> {
        if (source.rootPaths.isEmpty()) return emptyList()

        val foundMap = LinkedHashMap<String, ScannedLocalMedia>()

        fun addEntry(uriOrPath: String, rawTitle: String?, rawName: String?, mimeType: String?, forcedIsVideo: Boolean) {
            val clean = uriOrPath.trim()
            if (clean.isEmpty()) return

            val isContentUri = clean.startsWith("content://", ignoreCase = true)
            val canonPath = if (!isContentUri) safeCanonical(clean) else ""

            if (!isContentUri) {
                if (canonPath.isEmpty() || !belongsStrictlyToSource(canonPath, source)) return
                val f = File(canonPath)
                if (f.exists() && f.isDirectory) return
            }

            val isVid = detectMediaType(rawName ?: rawTitle ?: clean, mimeType) ?: forcedIsVideo
            val baseTitle = when {
                !rawTitle.isNullOrBlank() -> rawTitle.trim().substringBeforeLast('.').ifBlank { rawTitle.trim() }
                !rawName.isNullOrBlank() -> rawName.trim().substringBeforeLast('.').ifBlank { rawName.trim() }
                !isContentUri -> File(canonPath).nameWithoutExtension
                else -> ""
            }.ifBlank { if (isVid) "Video offline" else "Nhạc offline" }

            val finalUrl = if (isContentUri) clean else Uri.fromFile(File(canonPath)).toString()
            val dedupKey = if (isContentUri) finalUrl.lowercase(Locale.US) else normLower(canonPath)

            if (dedupKey.isNotEmpty() && !foundMap.containsKey(dedupKey)) {
                foundMap[dedupKey] = ScannedLocalMedia(
                    title = baseTitle,
                    url = finalUrl,
                    isVideo = isVid,
                    sourceId = source.id,
                    sourceLabel = source.label
                )
            }
        }

        // 1. Quét MediaStore chuẩn Android 13 (dùng _ID -> content:// URI, tương thích Scoped Storage)
        val collections = listOf(
            MediaStore.Audio.Media.EXTERNAL_CONTENT_URI to false,
            MediaStore.Video.Media.EXTERNAL_CONTENT_URI to true
        )

        for ((collectionUri, isVideoCol) in collections) {
            var cursor: Cursor? = null
            try {
                val idCol = MediaStore.MediaColumns._ID
                val titleCol = MediaStore.MediaColumns.TITLE
                val nameCol = MediaStore.MediaColumns.DISPLAY_NAME
                val mimeCol = MediaStore.MediaColumns.MIME_TYPE
                val relPathCol = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                    MediaStore.MediaColumns.RELATIVE_PATH
                } else {
                    null
                }

                val projectionList = mutableListOf(idCol, titleCol, nameCol, mimeCol)
                if (relPathCol != null) projectionList.add(relPathCol)
                @Suppress("DEPRECATION")
                projectionList.add(MediaStore.MediaColumns.DATA)

                val sortOrder = "${MediaStore.MediaColumns.DATE_ADDED} DESC"
                cursor = context.contentResolver.query(
                    collectionUri,
                    projectionList.toTypedArray(),
                    null,
                    null,
                    sortOrder
                )
                if (cursor != null) {
                    val iId = cursor.getColumnIndex(idCol)
                    val iTitle = cursor.getColumnIndex(titleCol)
                    val iName = cursor.getColumnIndex(nameCol)
                    val iMime = cursor.getColumnIndex(mimeCol)
                    val iRel = if (relPathCol != null) cursor.getColumnIndex(relPathCol) else -1
                    @Suppress("DEPRECATION")
                    val iData = cursor.getColumnIndex(MediaStore.MediaColumns.DATA)

                    while (cursor.moveToNext()) {
                        val id = if (iId >= 0) cursor.getLong(iId) else -1L
                        val rawTitle = if (iTitle >= 0) cursor.getString(iTitle) else null
                        val rawName = if (iName >= 0) cursor.getString(iName) else null
                        val rawMime = if (iMime >= 0) cursor.getString(iMime) else null
                        val rawRel = if (iRel >= 0) cursor.getString(iRel).orEmpty() else ""
                        @Suppress("DEPRECATION")
                        val rawData = if (iData >= 0) cursor.getString(iData).orEmpty() else ""

                        // Nếu có đường dẫn thực và nguồn hiện tại giới hạn ổ đĩa (Thẻ nhớ / USB), lọc theo đường dẫn
                        if (rawData.isNotBlank() && !source.isAllDisks && source.id != "internal") {
                            val canon = safeCanonical(rawData)
                            if (!belongsStrictlyToSource(canon, source)) continue
                        }

                        // Nếu là nguồn "Thẻ nhớ" hoặc "USB" nhưng không có đường dẫn thẻ/USB hợp lệ thì bỏ qua
                        if ((source.id == "sdcard" || source.id == "usb") && rawData.isBlank()) {
                            continue
                        }

                        // Nếu là nguồn "Bộ nhớ trong" và có RELATIVE_PATH rõ ràng thuộc thẻ/USB thì bỏ qua
                        if (source.id == "internal" && rawData.isNotBlank()) {
                            val canon = safeCanonical(rawData)
                            if (canon.isNotEmpty() && !belongsStrictlyToSource(canon, source)) continue
                        }

                        val contentUriStr = if (id > 0L) {
                            ContentUris.withAppendedId(collectionUri, id).toString()
                        } else {
                            ""
                        }

                        val chosenUri = when {
                            contentUriStr.isNotEmpty() -> contentUriStr
                            rawData.isNotBlank() -> Uri.fromFile(File(safeCanonical(rawData))).toString()
                            else -> ""
                        }

                        val hintName = if (rawName.isNullOrBlank() && rawRel.isNotBlank()) "$rawRel${rawTitle.orEmpty()}" else rawName
                        if (chosenUri.isNotEmpty()) {
                            addEntry(chosenUri, rawTitle, hintName, rawMime, isVideoCol)
                        }
                    }
                }
            } catch (e: Exception) {
                Log.e("KARA_SCAN", "MediaStore query error ($isVideoCol): ${e.message}")
            } finally {
                try { cursor?.close() } catch (_: Exception) {}
            }
        }

        // 2. Duyệt bổ sung thư mục người dùng nếu thiết bị cho phép đọc file trực tiếp
        val visitedDirs = HashSet<String>()
        fun walkUserDirectory(dir: File, rootCanon: String, depth: Int) {
            if (depth > MAX_SCAN_DEPTH) return
            try {
                if (!dir.exists() || !dir.isDirectory || !dir.canRead()) return
                if (isBlockedSystemOrHiddenPath(dir, rootCanon)) return

                val canonDir = safeCanonical(dir.absolutePath)
                if (canonDir.isEmpty() || !belongsStrictlyToSource(canonDir, source)) return

                val keyDir = normLower(canonDir)
                if (!visitedDirs.add(keyDir)) return

                val entries = dir.listFiles() ?: return
                for (entry in entries) {
                    try {
                        if (entry.isDirectory) {
                            if (!isBlockedSystemOrHiddenPath(entry, rootCanon)) {
                                walkUserDirectory(entry, rootCanon, depth + 1)
                            }
                        } else if (entry.isFile && entry.canRead() && !entry.name.startsWith(".")) {
                            val guessedVid = detectMediaType(entry.name, null)
                            if (guessedVid != null) {
                                addEntry(entry.absolutePath, entry.nameWithoutExtension, entry.name, null, guessedVid)
                            }
                        }
                    } catch (_: SecurityException) {
                    } catch (_: Exception) {}
                }
            } catch (_: SecurityException) {
            } catch (_: Exception) {}
        }

        for (root in source.rootPaths) {
            val rootCanon = safeCanonical(root)
            if (rootCanon.isEmpty()) continue
            val rootFile = File(rootCanon)
            if (!rootFile.exists() || !rootFile.isDirectory || !rootFile.canRead()) continue

            for (prefName in PREFERRED_USER_DIRS) {
                val prefDir = File(rootFile, prefName)
                if (prefDir.exists() && prefDir.isDirectory && prefDir.canRead()) {
                    walkUserDirectory(prefDir, rootCanon, 1)
                }
            }
        }

        return deduplicateMediaStrict(foundMap.values.toList())
    }

    fun parsePickedUris(context: Context, uris: List<Uri>): List<ScannedLocalMedia> {
        val rawList = ArrayList<ScannedLocalMedia>(uris.size)
        for (uri in uris) {
            val uriStr = uri.toString().trim()
            if (uriStr.isEmpty()) continue
            val mime = try {
                context.contentResolver.getType(uri)
            } catch (_: Exception) {
                null
            }
            val displayName = try {
                context.contentResolver.query(
                    uri,
                    arrayOf(MediaStore.MediaColumns.DISPLAY_NAME),
                    null,
                    null,
                    null
                )?.use { c ->
                    if (c.moveToFirst()) c.getString(0) else null
                }
            } catch (_: Exception) {
                null
            } ?: (uri.lastPathSegment?.substringAfterLast('/') ?: "Tệp đa phương tiện")

            val cleanTitle = displayName.substringBeforeLast('.').ifBlank { displayName }
            val isVid = detectMediaType(displayName, mime) ?: detectMediaType(uriStr, mime) ?: false
            rawList.add(
                ScannedLocalMedia(
                    title = cleanTitle,
                    url = uriStr,
                    isVideo = isVid,
                    sourceId = "picked",
                    sourceLabel = "Đã chọn"
                )
            )
        }
        return deduplicateMediaStrict(rawList)
    }

    fun launchExternalFileManagerChooser(
        activity: Activity,
        launcher: ActivityResultLauncher<Intent>,
        onUnavailable: () -> Unit
    ) {
        try {
            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
                addCategory(Intent.CATEGORY_OPENABLE)
                type = "*/*"
                putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("audio/*", "video/*"))
                putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)
            }
            launcher.launch(intent)
        } catch (_: Exception) {
            onUnavailable()
        }
    }

