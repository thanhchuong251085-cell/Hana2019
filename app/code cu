    private fun playOfflineSongImmediately(song: SongData) {
        if (isExitingApp) return
        val directTitle = (song["title"] ?: song["name"] ?: "Bài hát offline").toString()
        val directUrl = (song["url"] ?: "").toString()
        val localKey = (song["localKey"] ?: "").toString()
        val thumbUrl = (song["thumbnail"] ?: song["artwork"] ?: song["thumb"] ?: "").toString()

        val finalUrl = if (directUrl.isNotEmpty()) directUrl else (localSongsMap[localKey] ?: "")
        val isVid = isVideoMedia(song, finalUrl, directTitle, localKey)

        hasActiveSongPlaying = true
        isPlaying = true
        activeDisplayTitle = "🎵 $directTitle"
        tvStatus.text = activeDisplayTitle
        tvStatus.isSelected = true

        if (finalUrl.isNotEmpty()) {
            lastDispatchedVideoId = null
            lastDispatchedSoundCloudUrl = null
            playMediaExo(
                url = finalUrl,
                title = directTitle,
                thumbnailUrl = if (isVid) "" else thumbUrl,
                isVideoStream = isVid
            )
        }

        val nowMs = System.currentTimeMillis()
        val songKey = "song_$nowMs"
        val songDataWithTime = mapOf(
            "type" to "local",
            "localKey" to localKey,
            "title" to directTitle,
            "name" to directTitle,
            "url" to finalUrl,
            "isVideo" to isVid,
            "mediaType" to if (isVid) "video" else "audio",
            "priority" to false,
            "prioritySeq" to 0L,
            "clientTimestamp" to nowMs,
            "timestamp" to nowMs
        )
        roomRef?.child("playlist")?.child(songKey)?.setValue(songDataWithTime)
    }

    private fun playMediaExo(
        url: String,
        title: String = "",
        thumbnailUrl: String = "",
        isVideoStream: Boolean = false
    ) {
        if (isExitingApp) return
        try {
            runOnUiThread {
                if (isExitingApp) return@runOnUiThread
                if (isVideoStream) {
                    hideArtworkView()
                } else {
                    loadAudioCoverArt(thumbnailUrl, title, isVideoStream = false)
                }

                if (isOfflineActive && currentOfflineUrl == url) {
                    if (isVideoStream) {
                        hideArtworkView()
                        playerView?.visibility = View.VISIBLE
                        playerView?.bringToFront()
                    }
                    exoHostContainer?.visibility = View.VISIBLE
                    playerView?.useController = false
                    isPlaying = true
                    exoPlayer?.playWhenReady = true
                    exoPlayer?.play()
                    updateOfflineKeepScreenOn(true)
                    showCustomControlBar()
                    return@runOnUiThread
                }

                exoPlayer?.stop()
                exoPlayer?.clearMediaItems()

                hasActiveSongPlaying = true
                isOfflineActive = true
                isPlaying = true
                currentOfflineUrl = url
                setWelcomeBlinking(false)
                play1080?.stopForOffline()

                exoHostContainer?.visibility = View.VISIBLE
                if (isVideoStream) {
                    hideArtworkView()
                    playerView?.visibility = View.VISIBLE
                    playerView?.bringToFront()
                } else {
                    playerView?.visibility = View.GONE
                }
                playerView?.useController = false
                updateOfflineKeepScreenOn(true)
                showCustomControlBar()

                exoPlayer?.let { player ->
                    player.playWhenReady = true
                    player.setMediaItem(MediaItem.fromUri(Uri.parse(url)))
                    player.prepare()
                }
            }
        } catch (e: Exception) {
            Log.e("KARA_MEDIA", "Lỗi phát ExoPlayer: ${e.message}")
            updateOfflineKeepScreenOn(false)
        }
    }

    private fun playYouTube1080(videoId: String) {
        if (isExitingApp) return
        runOnUiThread {
            if (isExitingApp) return@runOnUiThread
            val isIdleCar = videoId == Play1080.IDLE_CAR_VIDEO_ID
            hasActiveSongPlaying = !isIdleCar
            isOfflineActive = false
            clearOfflinePlayerState(hideView = true)
            setWelcomeBlinking(isIdleCar)
            isPlaying = !isIdleCar
            play1080?.keepScreenOn = !isIdleCar && isPlaying
            syncPlayerKeepScreenOn()
            play1080?.playVideoId(videoId)
        }
    }

    private fun advanceToNextFromQueue() {
        hasActiveSongPlaying = false
        if (playlist.isNotEmpty()) {
            launchSongItem(playlist[0], consumeFromPlaylistIfPresent = true)
            updateUI()
        } else {
            stopPlayer()
            updateUI()
        }
    }

    private fun removeCurrentSong() {
        advanceToNextFromQueue()
    }

    private fun removeCurrentSongSilently() {
        if (isExitingApp) return
        advanceToNextFromQueue()
    }

    private fun stopPlayer() {
        if (isExitingApp) return
        hasActiveSongPlaying = false
        isOfflineActive = false
        isPlaying = false
        clearOfflinePlayerState(hideView = true)

        activeDisplayTitle = "🕒 Chờ bài hát..."
        tvStatus.text = activeDisplayTitle
        tvStatus.isSelected = true

        lastDispatchedVideoId = Play1080.IDLE_CAR_VIDEO_ID
        lastDispatchedSoundCloudUrl = null
        setWelcomeBlinking(true)
        play1080?.keepScreenOn = false
        syncPlayerKeepScreenOn()
        play1080?.playIdleCar()
    }

    private fun togglePlayPause() {
        if (isOfflineActive) {
            val player = exoPlayer ?: return
            val nextPlayState = !player.isPlaying
            isPlaying = nextPlayState
            player.playWhenReady = nextPlayState
            if (nextPlayState) {
                player.play()
            } else {
                player.pause()
            }
            updateOfflineKeepScreenOn(nextPlayState)
            updateCustomPlayPauseIcon(nextPlayState)
        } else {
            isPlaying = !isPlaying
            play1080?.setPaused(!isPlaying)
            play1080?.keepScreenOn = hasActiveSongPlaying && isPlaying
            syncPlayerKeepScreenOn()
        }
        showToast(if (isPlaying) "▶️ Tiếp tục" else "⏸ Tạm dừng")
    }

    private fun adjustVolumeSmooth(isUp: Boolean) {
        try {
            val maxVolume = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
            var currentVolume = audioManager.getStreamVolume(AudioManager.STREAM_MUSIC)
            if (isUp) { if (currentVolume < maxVolume) currentVolume += 1 }
            else { if (currentVolume > 0) currentVolume -= 1 }
            audioManager.setStreamVolume(AudioManager.STREAM_MUSIC, currentVolume, 0)
        } catch (_: Exception) {
            val direction = if (isUp) AudioManager.ADJUST_RAISE else AudioManager.ADJUST_LOWER
            audioManager.adjustStreamVolume(AudioManager.STREAM_MUSIC, direction, 0)
        }
    }

    private fun executeCommand(cmdData: Any) {
        if (isExitingApp) return
        if (cmdData is Map<*, *>) {
            val type = cmdData["type"] as? String
            val typeSource = (cmdData["typeSource"] ?: "").toString()
            val ytTitle = (cmdData["title"] ?: cmdData["name"] ?: "").toString()
            val videoId = (cmdData["videoId"] ?: "").toString()
            val remoteUrl = (cmdData["url"] ?: cmdData["videoUrl"] ?: "").toString()
            val localKey = (cmdData["localKey"] ?: "").toString()
            val thumbUrl = (cmdData["thumbnail"] ?: cmdData["artwork"] ?: cmdData["thumb"] ?: "").toString()

            @Suppress("UNCHECKED_CAST")
            val cmdMap = cmdData as SongData

            if (ytTitle.isNotEmpty() && !hasActiveSongPlaying) {
                activeDisplayTitle = "🎵 $ytTitle"
                tvStatus.text = activeDisplayTitle
                tvStatus.isSelected = true
            }

            when (type) {
                "PRIORITY", "PRIORITIZE", "ADD_PRIORITY", "PRIORITY_SONG" -> {
                    val nowMs = System.currentTimeMillis()
                    val songKey = "song_$nowMs"
                    val prioEntry = HashMap<String, Any>(cmdMap)
                    prioEntry["priority"] = true
                    prioEntry["prioritySeq"] = nowMs
                    prioEntry["priorityTime"] = nowMs
                    prioEntry["clientTimestamp"] = nowMs
                    prioEntry["timestamp"] = nowMs
                    roomRef?.child("playlist")?.child(songKey)?.setValue(prioEntry)
                }
                "PLAY_NOW" -> {
                    hasActiveSongPlaying = true
                    isPlaying = true
                    if (ytTitle.isNotEmpty()) {
                        activeDisplayTitle = "🎵 $ytTitle"
                        tvStatus.text = activeDisplayTitle
                        tvStatus.isSelected = true
                    }
                    if (typeSource == "soundcloud" && remoteUrl.isNotEmpty()) {
                        lastDispatchedVideoId = null
                        lastDispatchedSoundCloudUrl = "NOW|$remoteUrl|${System.currentTimeMillis()}"
                        playSoundCloud(remoteUrl, ytTitle, thumbUrl)
                    } else if (remoteUrl.isNotEmpty()) {
                        lastDispatchedVideoId = null
                        lastDispatchedSoundCloudUrl = null
                        val isVid = isVideoMedia(cmdMap, remoteUrl, ytTitle, localKey)
                        playMediaExo(
                            url = remoteUrl,
                            title = ytTitle,
                            thumbnailUrl = if (isVid) "" else thumbUrl,
                            isVideoStream = isVid
                        )
                    } else if (localKey.isNotEmpty() && localSongsMap.containsKey(localKey)) {
                        lastDispatchedVideoId = null
                        lastDispatchedSoundCloudUrl = null
                        val resolvedUrl = localSongsMap[localKey]!!
                        val isVid = isVideoMedia(cmdMap, resolvedUrl, ytTitle, localKey)
                        playMediaExo(
                            url = resolvedUrl,
                            title = ytTitle,
                            thumbnailUrl = if (isVid) "" else thumbUrl,
                            isVideoStream = isVid
                        )
                    } else if (videoId.isNotEmpty()) {
                        lastDispatchedSoundCloudUrl = null
                        lastDispatchedVideoId = "NOW|$videoId|${System.currentTimeMillis()}"
                        playYouTube1080(videoId)
                    }
                }
                "PLAY", "PAUSE" -> togglePlayPause()
                "NEXT" -> removeCurrentSong()
                "VOL_UP" -> adjustVolumeSmooth(true)
                "VOL_DOWN" -> adjustVolumeSmooth(false)
                "SET_HD" -> showToast("🎥 Đã tối ưu chất lượng luồng")
            }
        }
    }

    private fun showToast(message: String) {
        if (isExitingApp) return
        Toast.makeText(this, message, Toast.LENGTH_SHORT).show()
    }

    override fun onDestroy() {
        isPlaying = false
        syncPlayerKeepScreenOn()
        offlineFolderDialog?.dismiss()
        offlineFolderDialog = null
        stopProgressTicker()
        mainHandler.removeCallbacksAndMessages(null)
        blinkHandler.removeCallbacksAndMessages(null)
        roomValueEventListener?.let { roomRef?.child("playlist")?.removeEventListener(it) }
        commandEventListener?.let { roomRef?.child("command")?.removeEventListener(it) }
        localSongsEventListener?.let { roomRef?.child("localSongs")?.removeEventListener(it) }
        hideArtworkView()
        playerView?.keepScreenOn = false
        try {
            exoPlayer?.release()
        } catch (_: Exception) {}
        exoPlayer = null
        if (isExitingApp) {
            releasePlay1080Completely()
        }
        super.onDestroy()
    }
