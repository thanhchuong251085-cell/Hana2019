    /**
     * Luồng riêng cho SoundCloud: giữ sáng suốt từ lúc bóc tách tới khi hát, chỉ tắt khi Pause / dừng.
     */
    private fun playSoundCloud(soundCloudPageUrl: String, title: String = "", thumbnailUrl: String = "") {
        if (isExitingApp) return
        initNewPipeIfNeeded()

        runOnUiThread {
            if (isExitingApp) return@runOnUiThread
            stopExoCompletely(hideHost = false, keepArtwork = true)
            play1080?.stopForOffline()
            hasActiveSongPlaying = true
            isOfflineActive = true
            isSoundCloudSession = true
            isPlaying = true
            setWelcomeBlinking(false)
            if (title.isNotEmpty()) {
                activeDisplayTitle = "☁️ $title"
                tvStatus.text = activeDisplayTitle
                tvStatus.isSelected = true
            }
            exoHostContainer?.visibility = View.VISIBLE
            exoHostContainer?.setBackgroundColor(Color.BLACK)
            loadAudioCoverArt(thumbnailUrl, title, isVideoStream = false)
            syncPlayerKeepScreenOn()
            showCustomControlBar()
        }
        showToast("☁️ Đang bóc tách SoundCloud...")

        Thread {
            if (isExitingApp) return@Thread
            try {
                val extractor = ServiceList.SoundCloud.getStreamExtractor(soundCloudPageUrl)
                extractor.fetchPage()

                val resolvedThumb = if (thumbnailUrl.isNotBlank()) {
                    thumbnailUrl
                } else {
                    extractor.thumbnails.maxByOrNull { it.height * it.width }?.url.orEmpty()
                }

                val audioStreams = extractor.audioStreams
                val bestStream = audioStreams
                    .filter { !it.content.isNullOrBlank() }
                    .maxByOrNull { it.averageBitrate }
                    ?: audioStreams.firstOrNull { !it.content.isNullOrBlank() }

                val streamUrl = bestStream?.content
                if (streamUrl.isNullOrBlank()) {
                    runOnUiThread {
                        if (!isExitingApp) showToast("⚠️ Không lấy được luồng nhạc SoundCloud")
                    }
                    return@Thread
                }

                runOnUiThread {
                    if (!isSoundCloudSession || isExitingApp) return@runOnUiThread
                    lastDispatchedVideoId = null
                    playMediaExo(
                        url = streamUrl,
                        title = title,
                        thumbnailUrl = resolvedThumb,
                        isVideoStream = false
                    )
                }
            } catch (e: Exception) {
                Log.e("KARA_SC", "Lỗi bóc tách SoundCloud ($soundCloudPageUrl): ${e.message}")
                runOnUiThread {
                    if (!isExitingApp) {
                        showToast("⚠️ Lỗi bóc tách SoundCloud: ${e.message ?: "Không xác định"}")
                    }
                }
            }
        }.start()
    }

