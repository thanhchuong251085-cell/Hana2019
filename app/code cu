/**
 * Icon Play (tam giác) / Pause (hai gạch) nhỏ gọn, sắc nét.
 */
class PlayPauseIconDrawable(private val density: Float) : Drawable() {
    var isPlayingState: Boolean = true
        set(value) {
            if (field != value) {
                field = value
                invalidateSelf()
            }
        }

    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.WHITE
        style = Paint.Style.FILL
    }

    override fun draw(canvas: Canvas) {
        val b = bounds
        if (b.width() <= 0 || b.height() <= 0) return

        val w = b.width().toFloat()
        val h = b.height().toFloat()
        val cy = h / 2f

        if (isPlayingState) {
            val barW = (2.6f * density).coerceAtLeast(3f)
            val barH = h * 0.56f
            val gap = (3.2f * density).coerceAtLeast(4f)
            val totalW = barW * 2f + gap
            val left1 = (w - totalW) / 2f
            val top = cy - barH / 2f
            val bottom = cy + barH / 2f
            val corner = 1.2f * density

            canvas.drawRoundRect(left1, top, left1 + barW, bottom, corner, corner, paint)
            canvas.drawRoundRect(left1 + barW + gap, top, left1 + barW * 2f + gap, bottom, corner, corner, paint)
        } else {
            val triW = w * 0.52f
            val triH = h * 0.58f
            val left = (w - triW) / 2f + (1.2f * density)
            val top = cy - triH / 2f
            val bottom = cy + triH / 2f

            val path = Path().apply {
                moveTo(left, top)
                lineTo(left + triW, cy)
                lineTo(left, bottom)
                close()
            }
            canvas.drawPath(path, paint)
        }
    }

    override fun setAlpha(alpha: Int) {
        paint.alpha = alpha
        invalidateSelf()
    }

    override fun setColorFilter(colorFilter: ColorFilter?) {
        paint.colorFilter = colorFilter
        invalidateSelf()
    }

    @Deprecated("Deprecated in Java")
    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
}

/**
 * Icon Fullscreen 4 móc góc kiểu YouTube nhỏ gọn.
 */
class YouTubeFullscreenIconDrawable(private val density: Float) : Drawable() {
    var isExpanded: Boolean = false
        set(value) {
            if (field != value) {
                field = value
                invalidateSelf()
            }
        }

    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.WHITE
        style = Paint.Style.STROKE
        strokeWidth = (1.9f * density).coerceAtLeast(2.2f)
        strokeCap = Paint.Cap.SQUARE
        strokeJoin = Paint.Join.MITER
    }

    override fun draw(canvas: Canvas) {
        val b = bounds
        if (b.width() <= 0 || b.height() <= 0) return

        val pad = (6.5f * density)
        val left = b.left + pad
        val top = b.top + pad
        val right = b.right - pad
        val bottom = b.bottom - pad
        if (right <= left || bottom <= top) return

        val hook = ((right - left).coerceAtMost(bottom - top) * 0.34f).coerceAtLeast(3.5f * density)

        if (!isExpanded) {
            canvas.drawLine(left, top + hook, left, top, paint)
            canvas.drawLine(left, top, left + hook, top, paint)

            canvas.drawLine(right - hook, top, right, top, paint)
            canvas.drawLine(right, top, right, top + hook, paint)

            canvas.drawLine(left, bottom - hook, left, bottom, paint)
            canvas.drawLine(left, bottom, left + hook, bottom, paint)

            canvas.drawLine(right - hook, bottom, right, bottom, paint)
            canvas.drawLine(right, bottom, right, bottom - hook, paint)
        } else {
            canvas.drawLine(left + hook, top, left + hook, top + hook, paint)
            canvas.drawLine(left, top + hook, left + hook, top + hook, paint)

            canvas.drawLine(right - hook, top, right - hook, top + hook, paint)
            canvas.drawLine(right - hook, top + hook, right, top + hook, paint)

            canvas.drawLine(left + hook, bottom - hook, left + hook, bottom, paint)
            canvas.drawLine(left, bottom - hook, left + hook, bottom - hook, paint)

            canvas.drawLine(right - hook, bottom - hook, right - hook, bottom, paint)
            canvas.drawLine(right - hook, bottom - hook, right, bottom - hook, paint)
        }
    }

    override fun setAlpha(alpha: Int) {
        paint.alpha = alpha
        invalidateSelf()
    }

    override fun setColorFilter(colorFilter: ColorFilter?) {
        paint.colorFilter = colorFilter
        invalidateSelf()
    }

    @Deprecated("Deprecated in Java")
    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
}

/**
 * Downloader nhẹ dùng HttpURLConnection cho NewPipeExtractor.
 */
class SimpleHttpDownloader : Downloader() {
    @Throws(IOException::class, ReCaptchaException::class)
    override fun execute(request: Request): Response {
        val httpMethod = request.httpMethod()
        val urlString = request.url()
        val headers = request.headers()
        val dataToSend = request.dataToSend()

        val url = URL(urlString)
        val conn = (url.openConnection() as HttpURLConnection).apply {
            requestMethod = httpMethod
            connectTimeout = 15000
            readTimeout = 20000
            instanceFollowRedirects = true
            setRequestProperty("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)")
            headers.forEach { (key, values) ->
                values.forEach { v -> addRequestProperty(key, v) }
            }
        }

        if (dataToSend != null && dataToSend.isNotEmpty()) {
            conn.doOutput = true
            OutputStreamWriter(conn.outputStream, Charsets.UTF_8).use { writer ->
                writer.write(String(dataToSend, Charsets.UTF_8))
                writer.flush()
            }
        }

        val responseCode = conn.responseCode
        val responseMessage = conn.responseMessage ?: ""
        val inputStream = if (responseCode in 200..299) conn.inputStream else conn.errorStream

        val bodyBuilder = StringBuilder()
        if (inputStream != null) {
            BufferedReader(InputStreamReader(inputStream, Charsets.UTF_8)).use { reader ->
                var line: String?
                while (reader.readLine().also { line = it } != null) {
                    bodyBuilder.append(line).append('\n')
                }
            }
        }

        val responseHeaders = mutableMapOf<String, MutableList<String>>()
        conn.headerFields.forEach { (k, v) ->
            if (k != null && v != null) {
                responseHeaders[k] = v.toMutableList()
            }
        }

        return Response(
            responseCode,
            responseMessage,
            responseHeaders,
            bodyBuilder.toString(),
            conn.url.toString()
        )
    }
}

