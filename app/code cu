    /**
     * Ảnh bìa mặc định cho phần nhạc audio khi bài không có ảnh bìa riêng:
     * Có tiêu đề bài hát ở trên và biểu tượng nốt nhạc ở dưới.
     */
    private fun createAudioDefaultArtworkBitmap(songTitle: String): Bitmap {
        val width = 1280
        val height = 720
        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bitmap)

        val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(
                0f, 0f, width.toFloat(), height.toFloat(),
                intArrayOf(
                    Color.parseColor("#0D1321"),
                    Color.parseColor("#1D2D44"),
                    Color.parseColor("#121826")
                ),
                null,
                Shader.TileMode.CLAMP
            )
        }
        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), bgPaint)

        val cleanTitle = songTitle.trim().ifEmpty { "Nhạc Audio" }
        val titlePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.parseColor("#00FFCC")
            textSize = 42f
            typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
            textAlign = Paint.Align.CENTER
        }

        val maxTextWidth = width - 160f
        val displayTitle = if (titlePaint.measureText(cleanTitle) > maxTextWidth) {
            var s = cleanTitle
            while (s.isNotEmpty() && titlePaint.measureText("$s...") > maxTextWidth) {
                s = s.dropLast(1)
            }
            "$s..."
        } else {
            cleanTitle
        }

        val titleY = height * 0.36f
        canvas.drawText(displayTitle, width / 2f, titleY, titlePaint)

        val notePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.parseColor("#FFEB3B")
            style = Paint.Style.FILL
        }
        val noteCenterX = width / 2f
        val noteBaseY = height * 0.66f

        canvas.drawOval(noteCenterX - 58f, noteBaseY - 18f, noteCenterX - 10f, noteBaseY + 24f, notePaint)
        canvas.drawOval(noteCenterX + 18f, noteBaseY - 30f, noteCenterX + 66f, noteBaseY + 12f, notePaint)

        val stemTopY = noteBaseY - 125f
        canvas.drawRect(noteCenterX - 20f, stemTopY, noteCenterX - 10f, noteBaseY + 2f, notePaint)
        canvas.drawRect(noteCenterX + 56f, stemTopY - 12f, noteCenterX + 66f, noteBaseY - 10f, notePaint)

        val beamPath = Path().apply {
            moveTo(noteCenterX - 20f, stemTopY)
            lineTo(noteCenterX + 66f, stemTopY - 12f)
            lineTo(noteCenterX + 66f, stemTopY + 10f)
            lineTo(noteCenterX - 20f, stemTopY + 22f)
            close()
        }
        canvas.drawPath(beamPath, notePaint)

        return bitmap
    }

    /**
     * Chỉ dùng cho Audio / SoundCloud (tuyệt đối không gọi khi phát Video).
     * Có ảnh bìa riêng thì hiện ảnh bìa đó; không có thì tự gắn ảnh kèm nốt nhạc dưới tên bài hát.
     */
    private fun loadAudioCoverArt(thumbnailUrl: String, songTitle: String, isVideoStream: Boolean) {
        if (isVideoStream || isExitingApp) {
            hideArtworkView()
            return
        }

        runOnUiThread {
            if (isExitingApp) return@runOnUiThread
            exoHostContainer?.visibility = View.VISIBLE
            exoHostContainer?.setBackgroundColor(Color.BLACK)
            playerView?.visibility = View.GONE
            scArtworkView?.keepScreenOn = isPlaying
        }

        val cleanUrl = thumbnailUrl.trim()
        if (cleanUrl.isBlank()) {
            val fallbackBmp = createAudioDefaultArtworkBitmap(songTitle)
            runOnUiThread {
                if (isOfflineActive && !isExitingApp) {
                    scArtworkView?.setImageBitmap(fallbackBmp)
                    scArtworkView?.visibility = View.VISIBLE
                    scArtworkView?.alpha = 1f
                    scArtworkView?.keepScreenOn = isPlaying
                    if (isCustomBarVisible) {
                        customControlBar?.visibility = View.VISIBLE
                        customControlBar?.bringToFront()
                    }
                }
            }
            return
        }

        Thread {
            if (isExitingApp) return@Thread
            var loadedBitmap: Bitmap? = null
            try {
                val safeUrl = if (cleanUrl.startsWith("http://")) {
                    cleanUrl.replaceFirst("http://", "https://")
                } else {
                    cleanUrl
                }
                val conn = (URL(safeUrl).openConnection() as HttpURLConnection).apply {
                    connectTimeout = 10000
                    readTimeout = 10000
                    instanceFollowRedirects = true
                    setRequestProperty("User-Agent", "Mozilla/5.0")
                }
                conn.inputStream.use { input ->
                    loadedBitmap = BitmapFactory.decodeStream(input)
                }
            } catch (e: Exception) {
                Log.e("KARA_AUDIO_ART", "Lỗi tải ảnh bìa: ${e.message}")
            }

            if (isExitingApp) return@Thread
            val finalBitmap = loadedBitmap ?: createAudioDefaultArtworkBitmap(songTitle)
            runOnUiThread {
                if (isOfflineActive && !isExitingApp) {
                    scArtworkView?.setImageBitmap(finalBitmap)
                    scArtworkView?.visibility = View.VISIBLE
                    scArtworkView?.alpha = 1f
                    scArtworkView?.keepScreenOn = isPlaying
                    if (isCustomBarVisible) {
                        customControlBar?.visibility = View.VISIBLE
                        customControlBar?.bringToFront()
                    }
                }
            }
        }.start()
    }

    private fun stopExoCompletely(hideHost: Boolean, keepArtwork: Boolean = false) {
        stopProgressTicker()
        hideCustomControlBar()
        currentOfflineUrl = null
        playerView?.keepScreenOn = false
        scArtworkView?.keepScreenOn = false
        exoHostContainer?.keepScreenOn = false
        exoPlayer?.let { player ->
