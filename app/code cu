    private fun ensureMediaReadPermission(onReady: () -> Unit) {
        val needed = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            listOf(
                Manifest.permission.READ_MEDIA_AUDIO,
                Manifest.permission.READ_MEDIA_VIDEO
            )
        } else {
            listOf(Manifest.permission.READ_EXTERNAL_STORAGE)
        }

        val missing = needed.filter {
            ContextCompat.checkSelfPermission(this, it) != PackageManager.PERMISSION_GRANTED
        }

        if (missing.isEmpty()) {
            onReady()
        } else {
            onStoragePermissionGrantedAction = onReady
            requestMediaPermissionsLauncher.launch(missing.toTypedArray())
        }
    }

    private fun isSupportedMediaFile(displayName: String?, mimeType: String?, isVideoCollection: Boolean): Boolean {
        val ext = displayName
            ?.substringAfterLast('.', "")
            ?.lowercase(Locale.US)
            .orEmpty()
        val mime = mimeType?.lowercase(Locale.US).orEmpty()

        return if (isVideoCollection) {
            SUPPORTED_VIDEO_EXTS.contains(ext) || mime.startsWith("video/")
        } else {
            SUPPORTED_AUDIO_EXTS.contains(ext) || mime.startsWith("audio/")
        }
    }

    private fun scanDeviceMediaFiles(): List<ScannedLocalMedia> {
        val found = ArrayList<ScannedLocalMedia>()
        val seenUrls = HashSet<String>()

        fun queryCollection(collectionUri: Uri, isVideo: Boolean) {
            val idCol = MediaStore.MediaColumns._ID
            val titleCol = MediaStore.MediaColumns.TITLE
            val displayNameCol = MediaStore.MediaColumns.DISPLAY_NAME
            val mimeCol = MediaStore.MediaColumns.MIME_TYPE
            val projection = arrayOf(idCol, titleCol, displayNameCol, mimeCol)

            try {
                contentResolver.query(
                    collectionUri,
                    projection,
                    null,
                    null,
                    "${MediaStore.MediaColumns.DATE_ADDED} DESC"
                )?.use { cursor ->
                    val idIdx = cursor.getColumnIndex(idCol)
                    val titleIdx = cursor.getColumnIndex(titleCol)
                    val nameIdx = cursor.getColumnIndex(displayNameCol)
                    val mimeIdx = cursor.getColumnIndex(mimeCol)

                    while (cursor.moveToNext()) {
                        val id = if (idIdx != -1) cursor.getLong(idIdx) else -1L
                        if (id <= 0L) continue

                        val rawName = if (nameIdx != -1) cursor.getString(nameIdx) else null
                        val rawMime = if (mimeIdx != -1) cursor.getString(mimeIdx) else null
                        if (!isSupportedMediaFile(rawName, rawMime, isVideo)) continue

                        val contentUri = ContentUris.withAppendedId(collectionUri, id).toString()
                        if (seenUrls.contains(contentUri)) continue
                        seenUrls.add(contentUri)

                        val rawTitle = if (titleIdx != -1) cursor.getString(titleIdx) else null
                        val label = when {
                            !rawTitle.isNullOrBlank() -> rawTitle.trim()
                            !rawName.isNullOrBlank() -> rawName.trim()
                            else -> if (isVideo) "Video offline" else "Nhạc offline"
                        }
                        found.add(ScannedLocalMedia(title = label, url = contentUri, isVideo = isVideo))
                    }
                }
            } catch (e: Exception) {
                Log.e("KARA_SCAN", "Lỗi quét bộ nhớ ($isVideo): ${e.message}")
            }
        }

        queryCollection(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, isVideo = false)
        queryCollection(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, isVideo = true)
        return found
    }

    private fun scanOnlyForDisplay(showMessage: Boolean = false): List<ScannedLocalMedia> {
        val scanned = scanDeviceMediaFiles()
        if (showMessage) {
            showToast("🔍 Đã cập nhật ${scanned.size} tệp")
        }
        return scanned
    }

    /**
     * Chỉ gửi danh sách bài đã chọn xuống kho nhạc offline (`localSongs`) cho remote chọn gửi/ưu tiên/play now.
     * Tuyệt đối KHÔNG thêm vào `playlist` (danh sách nhạc chờ).
     */
    private fun sendSelectedOfflineSongsToFirebase(selectedItems: List<ScannedLocalMedia>) {
        if (selectedItems.isEmpty()) {
            showToast("⚠️ Bạn chưa chọn bài nào")
            return
        }

        val baseTime = System.currentTimeMillis()
        val localSongsUpdates = HashMap<String, Any>()
        val nextOfflineList = ArrayList<SongData>()

        selectedItems.forEachIndexed { idx, media ->
            val localKey = "song_${baseTime}_${idx}_${(1000..9999).random()}"
            val localEntry = mapOf<String, Any>(
                "localKey" to localKey,
                "title" to media.title,
                "name" to media.title,
                "url" to media.url,
                "isVideo" to media.isVideo,
                "mediaType" to if (media.isVideo) "video" else "audio"
            )
            localSongsMap[localKey] = media.url
            localIsVideoMap[localKey] = media.isVideo
            localSongsUpdates[localKey] = localEntry
            nextOfflineList.add(localEntry)
        }

        if (localSongsUpdates.isNotEmpty()) {
            roomRef?.child("localSongs")?.updateChildren(localSongsUpdates)
        }

        offlinePlaylist.clear()
        offlinePlaylist.addAll(nextOfflineList)
        renderOfflinePlaylist()

        showToast("✅ Đã gửi ${selectedItems.size} bài xuống danh sách offline cho remote!")
    }

