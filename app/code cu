    private fun rebuildGrid(
        gridContainer: LinearLayout,
        items: List<ScannedLocalMedia>,
        selectedUrls: LinkedHashSet<String>,
        columns: Int,
        onSelectionChanged: () -> Unit
    ) {
        gridContainer.removeAllViews()

        if (items.isEmpty()) {
            val emptyTv = TextView(this).apply {
                text = "Không có tệp nào trong mục này."
                setTextColor(Color.parseColor("#B0B8C4"))
                textSize = 14f
                gravity = Gravity.CENTER
                setPadding(16.dp(), 40.dp(), 16.dp(), 40.dp())
            }
            gridContainer.addView(emptyTv)
            return
        }

        var rowIndex = 0
        while (rowIndex * columns < items.size) {
            val rowLayout = LinearLayout(this).apply {
                orientation = LinearLayout.HORIZONTAL
                gravity = Gravity.START or Gravity.TOP
                layoutParams = LinearLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.WRAP_CONTENT
                ).apply { bottomMargin = 8.dp() }
            }

            for (col in 0 until columns) {
                val itemIndex = rowIndex * columns + col
                val cellParams = LinearLayout.LayoutParams(
                    0,
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    1f
                ).apply {
                    if (col > 0) leftMargin = 6.dp()
                    if (col < columns - 1) rightMargin = 6.dp()
                }

                if (itemIndex < items.size) {
                    val media = items[itemIndex]
                    val isChecked = selectedUrls.contains(media.url)

                    val card = LinearLayout(this).apply {
                        orientation = LinearLayout.VERTICAL
                        gravity = Gravity.CENTER_HORIZONTAL
                        isClickable = true
                        isFocusable = true
                        setPadding(6.dp(), 8.dp(), 6.dp(), 8.dp())
                        layoutParams = cellParams
                        background = GradientDrawable().apply {
                            shape = GradientDrawable.RECTANGLE
                            cornerRadius = 8.dp().toFloat()
                            setColor(
                                if (isChecked) Color.parseColor("#1D4E3E")
                                else Color.parseColor("#1C212B")
                            )
                            setStroke(
                                if (isChecked) 2.dp() else 1.dp(),
                                if (isChecked) Color.parseColor("#00E6A8")
                                else Color.parseColor("#323B4A")
                            )
                        }
                    }

                    val topRow = LinearLayout(this).apply {
                        orientation = LinearLayout.HORIZONTAL
                        gravity = Gravity.CENTER_VERTICAL
                        layoutParams = LinearLayout.LayoutParams(
                            ViewGroup.LayoutParams.MATCH_PARENT,
                            ViewGroup.LayoutParams.WRAP_CONTENT
                        )
                    }

                    val cbItem = CheckBox(this).apply {
                        this.isChecked = isChecked
                        setPadding(0, 0, 0, 0)
                        layoutParams = LinearLayout.LayoutParams(
                            ViewGroup.LayoutParams.WRAP_CONTENT,
                            ViewGroup.LayoutParams.WRAP_CONTENT
                        )
                    }

                    val tvIcon = TextView(this).apply {
                        text = if (media.isVideo) "🎬" else "🎵"
                        textSize = 18f
                        gravity = Gravity.CENTER
                        layoutParams = LinearLayout.LayoutParams(
                            0,
                            ViewGroup.LayoutParams.WRAP_CONTENT,
                            1f
                        )
                    }

                    topRow.addView(cbItem)
                    topRow.addView(tvIcon)

                    val tvTitle = TextView(this).apply {
                        text = media.title
                        setTextColor(Color.WHITE)
                        textSize = 11f
                        maxLines = 2
                        ellipsize = TextUtils.TruncateAt.END
                        gravity = Gravity.CENTER
                        setPadding(2.dp(), 4.dp(), 2.dp(), 0)
                    }

                    card.addView(topRow)
                    card.addView(tvTitle)

                    val toggleSelection = {
                        if (selectedUrls.contains(media.url)) {
                            selectedUrls.remove(media.url)
                        } else {
                            selectedUrls.add(media.url)
                        }
                        onSelectionChanged()
                        rebuildGrid(gridContainer, items, selectedUrls, columns, onSelectionChanged)
                    }

                    card.setOnClickListener { toggleSelection() }
                    cbItem.setOnClickListener { toggleSelection() }

                    rowLayout.addView(card)
                } else {
                    val emptySlot = View(this).apply {
                        layoutParams = cellParams
                    }
                    rowLayout.addView(emptySlot)
                }
            }

            gridContainer.addView(rowLayout)
            rowIndex++
        }
    }

    /**
     * Thoát hẳn ứng dụng, dừng toàn bộ luồng phát và giải phóng tiến trình khỏi RAM khi bấm nút Back.
     */
    private fun exitApplicationCompletely() {
        if (isExitingApp) return
        isExitingApp = true

        try {
            offlineFolderDialog?.dismiss()
        } catch (_: Exception) {}
        offlineFolderDialog = null

        stopProgressTicker()
        mainHandler.removeCallbacksAndMessages(null)
        blinkHandler.removeCallbacksAndMessages(null)
        shouldBlinkWelcome = false

        try {
            roomValueEventListener?.let { roomRef?.child("playlist")?.removeEventListener(it) }
            commandEventListener?.let { roomRef?.child("command")?.removeEventListener(it) }
            localSongsEventListener?.let { roomRef?.child("localSongs")?.removeEventListener(it) }
        } catch (_: Exception) {}
        roomValueEventListener = null
        commandEventListener = null
        localSongsEventListener = null

        hasActiveSongPlaying = false
        isOfflineActive = false
        isSoundCloudSession = false
        isPlaying = false

        stopExoCompletely(hideHost = true, keepArtwork = false)
        releasePlay1080Completely()

        exoPlayer?.let { player ->
            try {
                player.release()
            } catch (_: Exception) {}
        }
        exoPlayer = null
        playerView?.player = null

        try {
            finishAndRemoveTask()
        } catch (_: Exception) {
            try {
                finishAffinity()
            } catch (_: Exception) {
                finish()
            }
        }

        Process.killProcess(Process.myPid())
        System.exit(0)
    }

