        val player = exoPlayer ?: return
        val duration = player.duration.takeIf { it > 0L } ?: 0L
        val position = player.currentPosition.coerceAtLeast(0L).coerceAtMost(if (duration > 0L) duration else Long.MAX_VALUE)

        if (!isUserSeeking && seekCustomProgress != null) {
            val maxSeek = duration.coerceAtLeast(1L).coerceAtMost(Int.MAX_VALUE.toLong()).toInt()
            seekCustomProgress?.max = maxSeek
            seekCustomProgress?.progress = position.coerceAtMost(maxSeek.toLong()).toInt()
        }

        tvCustomTime?.text = "${formatTimeMs(position)} / ${formatTimeMs(duration)}"
        updateCustomPlayPauseIcon(player.isPlaying)
    }

